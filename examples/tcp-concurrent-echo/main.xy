导入 std::追加写入文本文件;
导入 std::TCP监听器接受连接;
导入 std::TCP监听器本地地址;
导入 std::TCP监听器与连接列表等待事件;
导入 std::TCP连接;
导入 std::TCP连接列表等待读取;
导入 std::TCP连接对端地址;
导入 std::TCP连接接收字节;
导入 std::TCP连接发送字节;
导入 std::列表;
导入 std::列表创建;
导入 std::列表追加;
导入 std::列表取出指定项;
导入 std::列表长度;
导入 std::建立TCP监听器;
导入 std::获取必需程序参数;
导入 std::文本连接;
导入 std::写入文本文件;

函数 并发回显两个TCP连接(地址: 字符串, 地址输出路径: 字符串, 对端地址输出路径: 字符串) -> 结果<整数, 字符串> {
    令 监听器 = 建立TCP监听器(地址)?;
    令 实际地址 = TCP监听器本地地址(监听器)?;
    写入文本文件(地址输出路径, 实际地址)?;
    变量 连接列表: 列表<TCP连接> = 列表创建();
    变量 已接受 = 0;
    变量 已关闭 = 0;
    当 已关闭 < 2 {
        变量 事件槽位 = 0;
        如果 已接受 < 2 {
            匹配 TCP监听器与连接列表等待事件(监听器, 连接列表, -1)? {
                可选::有值(槽位) => {
                    事件槽位 = 槽位;
                },
                可选::空值 => {
                    返回 结果::失败("监听器与连接列表等待意外结束");
                },
            };
        }
        如果 已接受 >= 2 {
            匹配 TCP连接列表等待读取(连接列表, -1)? {
                可选::有值(下标) => {
                    事件槽位 = 下标 + 1;
                },
                可选::空值 => {
                    返回 结果::失败("连接列表等待意外结束");
                },
            };
        }
        如果 事件槽位 == 0 {
            令 新连接 = TCP监听器接受连接(监听器)?;
            如果 已接受 == 0 {
                写入文本文件(对端地址输出路径, 文本连接(TCP连接对端地址(新连接)?, "\n"))?;
            }
            如果 已接受 > 0 {
                追加写入文本文件(对端地址输出路径, 文本连接(TCP连接对端地址(新连接)?, "\n"))?;
            }
            列表追加(连接列表, 新连接);
            已接受 = 已接受 + 1;
            继续;
        }
        令 就绪下标 = 事件槽位 - 1;
        匹配 列表取出指定项(连接列表, 就绪下标) {
            可选::有值(连接) => {
                变量 当前连接 = 连接;
                匹配 TCP连接接收字节(当前连接, 4096)? {
                    可选::有值(分块) => {
                        TCP连接发送字节(当前连接, 分块)?;
                        列表追加(连接列表, 当前连接);
                    },
                    可选::空值 => {
                        已关闭 = 已关闭 + 1;
                    },
                };
            },
            可选::空值 => {
                返回 结果::失败("就绪连接下标无效");
            },
        };
    }
    结果::成功(2)
}

函数 主函数() -> 结果<整数, 字符串> {
    并发回显两个TCP连接(获取必需程序参数(0, "缺少监听地址")?, 获取必需程序参数(1, "缺少监听地址输出文件路径")?, 获取必需程序参数(2, "缺少对端地址输出文件路径")?)
}
