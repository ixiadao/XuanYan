导入 std::TCP连接;
导入 std::TCP连接关闭发送;
导入 std::TCP连接接收字节;
导入 std::TCP连接本地地址;
导入 std::TCP连接发送字节;
导入 std::列表;
导入 std::列表创建;
导入 std::列表追加;
导入 std::列表长度;
导入 std::建立TCP连接;
导入 std::获取必需程序参数;
导入 std::文本字节;
导入 std::文本字节长度;
导入 std::写入二进制文件;
导入 std::写入文本文件;

函数 文本获取UTF8字节(文本值: 借用<字符串>, 下标: 整数) -> 结果<字节, 字符串> {
    匹配 文本字节(文本值, 下标) {
        可选::有值(字节值) => 结果::成功(字节值),
        可选::空值 => 结果::失败("文本 UTF-8 字节访问不一致"),
    }
}

函数 文本编码为UTF8字节(文本值: 借用<字符串>) -> 结果<列表<字节>, 字符串> {
    变量 字节列表: 列表<字节> = 列表创建();
    变量 下标 = 0;
    当 下标 < 文本字节长度(文本值) {
        列表追加(字节列表, 文本获取UTF8字节(文本值, 下标)?);
        下标 = 下标 + 1;
    }
    结果::成功(字节列表)
}

函数 响应追加分块(响应: 可变借用<列表<字节>>, 分块: 列表<字节>) -> 布尔 {
    遍历 字节值 在 (分块) {
        列表追加(响应, 字节值);
    }
    真
}

函数 接收全部字节(连接: 可变借用<TCP连接>) -> 结果<列表<字节>, 字符串> {
    变量 响应: 列表<字节> = 列表创建();
    变量 连接未结束 = 真;
    当 连接未结束 {
        连接未结束 = 匹配 TCP连接接收字节(连接, 4096)? {
            可选::有值(分块) => 响应追加分块(响应, 分块),
            可选::空值 => 假,
        };
    }
    结果::成功(响应)
}

函数 发送TCP请求(地址: 字符串, 请求文本: 字符串, 输出路径: 字符串, 本地地址输出路径: 字符串) -> 结果<整数, 字符串> {
    变量 连接 = 建立TCP连接(地址)?;
    令 本地地址 = TCP连接本地地址(连接)?;
    写入文本文件(本地地址输出路径, 本地地址)?;
    令 请求字节 = 文本编码为UTF8字节(请求文本)?;
    TCP连接发送字节(连接, 请求字节)?;
    TCP连接关闭发送(连接)?;
    令 响应 = 接收全部字节(连接)?;
    令 响应字节数 = 列表长度(响应);
    写入二进制文件(输出路径, 响应)?;
    结果::成功(响应字节数)
}

函数 主函数() -> 结果<整数, 字符串> {
    发送TCP请求(获取必需程序参数(0, "缺少服务器地址")?, 获取必需程序参数(1, "缺少请求文本")?, 获取必需程序参数(2, "缺少输出文件路径")?, 获取必需程序参数(3, "缺少本地地址输出文件路径")?)
}
