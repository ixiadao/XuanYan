函数 创建空值() -> 空 {}

函数 路径位于目录内(路径: 字符串, 目录: 借用<字符串>) -> 布尔 {
    如果 路径.到文本() == 目录.到文本() {
        返回 真;
    }
    匹配 路径父目录(路径) {
        结果::成功(父目录) => 路径位于目录内(父目录, 目录),
        结果::失败(_) => 假,
    }
}

函数 截取请求路径(目标: 借用<字符串>) -> 结果<字符串, 整数> {
    匹配 文本截取(目标, 1, 文本长度(目标) - 1) {
        可选::有值(路径值) => 结果::成功(路径值),
        可选::空值 => 结果::失败(400),
    }
}

函数 验证静态路径(目标: 借用<字符串>) -> 结果<空, 整数> {
    如果 文本包含(目标, "%") 或 文本包含(目标, "..") 或 文本包含(目标, ":") 或 文本包含(目标, "//") {
        返回 结果::失败(400);
    }
    结果::成功(创建空值())
}

函数 查询路径存在(路径: 借用<字符串>) -> 结果<布尔, 整数> {
    匹配 路径存在(路径) {
        结果::成功(结果值) => 结果::成功(结果值),
        结果::失败(_) => 结果::失败(500),
    }
}

函数 规范化请求路径(路径: 借用<字符串>) -> 结果<字符串, 整数> {
    匹配 路径规范化(路径) {
        结果::成功(路径值) => 结果::成功(路径值),
        结果::失败(_) => 结果::失败(500),
    }
}

函数 查询普通文件(路径: 借用<字符串>) -> 结果<布尔, 整数> {
    匹配 路径是文件(路径) {
        结果::成功(结果值) => 结果::成功(结果值),
        结果::失败(_) => 结果::失败(500),
    }
}

函数 读取请求文件(路径: 借用<字符串>) -> 结果<列表<字节>, 整数> {
    匹配 读取二进制文件(路径) {
        结果::成功(内容) => 结果::成功(内容),
        结果::失败(_) => 结果::失败(500),
    }
}

函数 读取目标文件(根目录: 借用<字符串>, 目标: 字符串) -> 结果<列表<字节>, 整数> {
    验证静态路径(目标)?;
    令 相对路径 = 如果 目标 == "/" {
        "index.html"
    } 否则 {
        截取请求路径(目标)?
    };
    令 候选路径 = 路径连接(根目录, 相对路径);
    如果 非 查询路径存在(候选路径)? {
        返回 结果::失败(404);
    }
    令 标准路径 = 规范化请求路径(候选路径)?;
    如果 非 路径位于目录内(标准路径.到文本(), 根目录) {
        返回 结果::失败(404);
    }
    如果 非 查询普通文件(标准路径)? {
        返回 结果::失败(404);
    }
    读取请求文件(标准路径)
}

函数 处理请求(连接: 可变借用<TCP连接>, 根目录: 借用<字符串>, 请求: HTTP请求) -> 结果<布尔, 字符串> {
    匹配 请求 {
        HTTP请求 { 方法, 路径, 正文, 保持连接 } => {
            令 忽略正文 = 正文;
            令 是HEAD = 方法 == "HEAD";
            如果 方法 != "GET" 且 非 是HEAD {
                发送HTTP错误响应(连接, 405, 非 是HEAD, 保持连接)?;
                返回 结果::成功(保持连接);
            }
            匹配 读取目标文件(根目录, 路径) {
                结果::成功(响应正文) => {
                    发送HTTP响应(连接, 200, "application/octet-stream", 响应正文, 非 是HEAD, 保持连接)?;
                },
                结果::失败(状态码) => {
                    发送HTTP错误响应(连接, 状态码, 非 是HEAD, 保持连接)?;
                },
            };
            令 _ = 忽略正文;
            结果::成功(保持连接)
        },
    }
}

函数 处理连接(连接: 可变借用<TCP连接>, 根目录: 借用<字符串>) -> 结果<空, 字符串> {
    变量 缓冲区: 列表<字节> = 列表创建();
    变量 继续读取 = 真;
    当 继续读取 {
        变量 请求 = HTTP请求 { 方法: "", 路径: "", 正文: 列表创建(), 保持连接: 假 };
        令 读取状态 = 读取HTTP请求(连接, 缓冲区, 30000, 8192, 1048576, 请求);
        如果 读取状态 == 0 {
            TCP连接关闭发送(连接)?;
            继续读取 = 假;
            继续;
        }
        如果 读取状态 != 200 {
            发送HTTP错误响应(连接, 读取状态, 真, 假)?;
            继续读取 = 假;
            继续;
        }
        继续读取 = 处理请求(连接, 根目录, 请求)?;
    }
    结果::成功(创建空值())
}

函数 标准化根目录(根目录: 字符串) -> 结果<字符串, 字符串> {
    令 标准根目录 = 路径规范化(根目录)?;
    如果 非 路径是目录(标准根目录)? {
        返回 结果::失败("静态文件根路径必须是目录");
    }
    结果::成功(标准根目录)
}

函数 处理连接任务(连接: TCP连接) -> 结果<空, 字符串> {
    变量 当前连接 = 连接;
    令 标准根目录 = 标准化根目录(获取必需程序参数(1, "缺少静态文件根目录")?)?;
    处理连接(当前连接, 标准根目录)
}

函数 处理指定数量连接(监听器: 借用<TCP监听器>, 连接数量: 整数) -> 结果<空, 字符串> {
    如果 连接数量 == 0 {
        返回 结果::成功(创建空值());
    }
    令 连接 = TCP监听器接受连接(监听器)?;
    令 任务 = 函数() -> 结果<空, 字符串> {
        处理连接任务(连接)
    };
    令 线程值 = 启动线程(任务)?;
    令 后续结果 = 处理指定数量连接(监听器, 连接数量 - 1);
    令 当前结果 = 等待线程(线程值);
    后续结果?;
    当前结果
}

函数 运行静态文件服务器(地址: 字符串, 根目录: 字符串, 地址输出路径: 字符串, 连接数量: 整数) -> 结果<整数, 字符串> {
    如果 连接数量 <= 0 {
        返回 结果::失败("连接数量必须是正整数");
    }
    标准化根目录(根目录)?;
    令 监听器 = 建立TCP监听器(地址)?;
    写入文本文件(地址输出路径, TCP监听器本地地址(监听器)?)?;
    处理指定数量连接(监听器, 连接数量)?;
    结果::成功(连接数量)
}

函数 主函数() -> 结果<整数, 字符串> {
    令 连接数量文本 = 获取必需程序参数(3, "缺少连接数量")?;
    运行静态文件服务器(获取必需程序参数(0, "缺少监听地址")?, 获取必需程序参数(1, "缺少静态文件根目录")?, 获取必需程序参数(2, "缺少监听地址输出文件路径")?, 整数::从文本(连接数量文本)?)
}
