函数 创建空值() -> 空 {}

函数 处理请求(连接: 可变借用<TCP连接>, 页面路径: 借用<字符串>, 请求: HTTP请求) -> 结果<布尔, 字符串> {
    匹配 请求 {
        HTTP请求 { 方法, 路径, 正文, 保持连接 } => {
            令 是HEAD = 方法 == "HEAD";
            如果 路径 == "/" {
                如果 方法 != "GET" 且 非 是HEAD {
                    发送HTTP错误响应(连接, 405, 真, 保持连接)?;
                    返回 结果::成功(保持连接);
                }
                令 页面 = 读取二进制文件(页面路径)?;
                发送HTTP响应(连接, 200, "text/html; charset=utf-8", 页面, 非 是HEAD, 保持连接)?;
                返回 结果::成功(保持连接);
            }
            如果 路径 == "/api/status" {
                如果 方法 != "GET" 且 非 是HEAD {
                    发送HTTP错误响应(连接, 405, 真, 保持连接)?;
                    返回 结果::成功(保持连接);
                }
                令 状态 = 文本到UTF8字节("{\"runtime\":\"native\",\"http\":\"1.1\",\"async\":false}\n")?;
                发送HTTP响应(连接, 200, "application/json; charset=utf-8", 状态, 非 是HEAD, 保持连接)?;
                返回 结果::成功(保持连接);
            }
            如果 路径 == "/api/echo" {
                如果 方法 != "POST" {
                    发送HTTP错误响应(连接, 405, 真, 保持连接)?;
                    返回 结果::成功(保持连接);
                }
                发送HTTP响应(连接, 200, "text/plain; charset=utf-8", 正文, 真, 保持连接)?;
                返回 结果::成功(保持连接);
            }
            发送HTTP错误响应(连接, 404, 非 是HEAD, 保持连接)?;
            结果::成功(保持连接)
        },
    }
}

函数 处理连接(连接: 可变借用<TCP连接>, 页面路径: 借用<字符串>) -> 结果<空, 字符串> {
    变量 缓冲区: 列表<字节> = 列表创建();
    变量 继续读取 = 真;
    当 继续读取 {
        变量 请求 = HTTP请求 { 方法: "", 路径: "", 正文: 列表创建(), 保持连接: 假 };
        令 读取状态 = 读取HTTP请求(连接, 缓冲区, 30000, 8192, 1048576, 请求);
        如果 读取状态 == 0 {
            TCP连接关闭发送(连接)?;
            继续读取 = 假;
            继续;
        }
        如果 读取状态 != 200 {
            发送HTTP错误响应(连接, 读取状态, 真, 假)?;
            继续读取 = 假;
            继续;
        }
        继续读取 = 处理请求(连接, 页面路径, 请求)?;
    }
    结果::成功(创建空值())
}

函数 处理连接任务(连接: TCP连接) -> 结果<空, 字符串> {
    变量 当前连接 = 连接;
    处理连接(当前连接, 获取必需程序参数(1, "缺少页面文件路径")?)
}

函数 处理指定数量连接(监听器: 借用<TCP监听器>, 连接数量: 整数) -> 结果<空, 字符串> {
    如果 连接数量 == 0 {
        返回 结果::成功(创建空值());
    }
    令 连接 = TCP监听器接受连接(监听器)?;
    令 任务 = 函数() -> 结果<空, 字符串> {
        处理连接任务(连接)
    };
    令 线程值 = 启动线程(任务)?;
    令 后续结果 = 处理指定数量连接(监听器, 连接数量 - 1);
    令 当前结果 = 等待线程(线程值);
    后续结果?;
    当前结果
}

函数 主函数() -> 结果<整数, 字符串> {
    令 连接数量 = 整数::从文本(获取必需程序参数(3, "缺少连接数量")?)?;
    如果 连接数量 <= 0 {
        返回 结果::失败("连接数量必须是正整数");
    }
    令 监听器 = 建立TCP监听器(获取必需程序参数(0, "缺少监听地址")?)?;
    写入文本文件(获取必需程序参数(2, "缺少监听地址输出文件路径")?, TCP监听器本地地址(监听器)?)?;
    处理指定数量连接(监听器, 连接数量)?;
    结果::成功(连接数量)
}
