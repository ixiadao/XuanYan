导入 std::获取必需程序参数;
导入 std::读取二进制文件;
导入 std::列表;
导入 std::列表创建;
导入 std::列表追加;
导入 std::列表长度;
导入 std::文本追加;
导入 std::写入二进制文件;

函数 待过滤字节(内容: 列表<字节>) -> 列表<字节> {
    内容
}

函数 过滤文件(输入路径: 字符串, 输出路径: 字符串) -> 结果<字符串, 字符串> {
    变量 输入 = 读取二进制文件(输入路径)?;
    令 读取数量 = 列表长度(输入);
    变量 输出: 列表<字节> = 列表创建();
    变量 移除数量 = 0;
    遍历 值 在 待过滤字节(输入) {
        如果 值 == 0 {
            移除数量 = 移除数量 + 1;
            继续;
        }
        列表追加(输出, 值);
    }
    令 写入数量 = 列表长度(输出);
    写入二进制文件(输出路径, 输出)?;
    变量 报告 = "读取字节：";
    文本追加(报告, 读取数量.到文本());
    文本追加(报告, "\n写入字节：");
    文本追加(报告, 写入数量.到文本());
    文本追加(报告, "\n移除字节：");
    文本追加(报告, 移除数量.到文本());
    结果::成功(报告)
}

函数 主函数() -> 结果<字符串, 字符串> {
    过滤文件(获取必需程序参数(0, "缺少输入路径")?, 获取必需程序参数(1, "缺少输出路径")?)
}
