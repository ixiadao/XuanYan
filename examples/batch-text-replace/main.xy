导入 std::创建目录;
导入 std::获取必需程序参数;
导入 std::列表;
导入 std::列表追加;
导入 std::列表创建;
导入 std::读取目录文件;
导入 std::读取文本文件;
导入 std::路径连接;
导入 std::路径文件名;
导入 std::文本替换;
导入 std::写入文本文件;

结构体 待写入文件 {
    路径: 字符串,
    内容: 字符串,
}

函数 准备待写入文件(输入目录: 借用<字符串>, 输出目录: 借用<字符串>, 原片段: 借用<字符串>, 新片段: 借用<字符串>) -> 结果<列表<待写入文件>, 字符串> {
    文本替换("", 原片段, 新片段)?;
    变量 待写入列表: 列表<待写入文件> = 列表创建();
    遍历 输入路径 在 读取目录文件(输入目录)? {
        令 文件名 = 路径文件名(输入路径)?;
        令 输出路径 = 路径连接(输出目录, 文件名);
        令 输入 = 读取文本文件(输入路径)?;
        令 输出 = 文本替换(输入, 原片段, 新片段)?;
        列表追加(待写入列表, 待写入文件 { 路径: 输出路径, 内容: 输出 });
    }
    创建目录(输出目录)?;
    结果::成功(待写入列表)
}

函数 写入待写入文件(文件: 待写入文件) -> 结果<字符串, 字符串> {
    匹配 文件 {
        待写入文件 { 路径, 内容 } => {
            写入文本文件(路径, 内容)?;
            结果::成功(路径)
        },
    }
}

函数 批量替换目录(输入目录: 字符串, 输出目录: 字符串, 原片段: 字符串, 新片段: 字符串) -> 结果<字符串, 字符串> {
    遍历 文件 在 准备待写入文件(输入目录, 输出目录, 原片段, 新片段)? {
        写入待写入文件(文件)?;
    }
    结果::成功(输出目录)
}

函数 主函数() -> 结果<字符串, 字符串> {
    令 输入目录 = 获取必需程序参数(0, "缺少输入目录")?;
    令 输出目录 = 获取必需程序参数(1, "缺少输出目录")?;
    令 原片段 = 获取必需程序参数(2, "缺少原片段")?;
    令 新片段 = 获取必需程序参数(3, "缺少新片段")?;
    批量替换目录(输入目录, 输出目录, 原片段, 新片段)
}
