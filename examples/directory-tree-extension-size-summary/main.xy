导入 std::获取必需程序参数;
导入 std::读取目录;
导入 std::路径是目录;
导入 std::路径是文件;
导入 std::路径扩展名是;
导入 std::文件大小;
导入 std::文本追加;

结构体 汇总结果 {
    文件数: 整数,
    总字节数: 整数,
}

函数 汇总目录(目录: 借用<字符串>, 目标扩展名: 借用<字符串>) -> 结果<汇总结果, 字符串> {
    变量 汇总 = 汇总结果 { 文件数: 0, 总字节数: 0 };
    遍历 路径 在 读取目录(目录)? {
        令 是文件 = 路径是文件(路径)?;
        如果 是文件 {
            如果 非 路径扩展名是(路径, 目标扩展名) {
                继续;
            }
            汇总.文件数 = 汇总.文件数 + 1;
            汇总.总字节数 = 汇总.总字节数 + 文件大小(路径)?;
            继续;
        }
        令 是目录 = 路径是目录(路径)?;
        如果 非 是目录 {
            继续;
        }
        令 子目录汇总 = 汇总目录(路径, 目标扩展名)?;
        汇总.文件数 = 汇总.文件数 + 子目录汇总.文件数;
        汇总.总字节数 = 汇总.总字节数 + 子目录汇总.总字节数;
    }
    结果::成功(汇总)
}

函数 生成报告(汇总: 汇总结果) -> 字符串 {
    匹配 汇总 {
        汇总结果 { 文件数, 总字节数 } => {
            变量 报告 = "文件数：";
            文本追加(报告, 文件数.到文本());
            文本追加(报告, "\n总字节数：");
            文本追加(报告, 总字节数.到文本());
            报告
        },
    }
}

函数 主函数() -> 结果<字符串, 字符串> {
    令 目录 = 获取必需程序参数(0, "缺少目录路径")?;
    令 目标扩展名 = 获取必需程序参数(1, "缺少目标扩展名")?;
    结果::成功(生成报告(汇总目录(目录, 目标扩展名)?))
}
