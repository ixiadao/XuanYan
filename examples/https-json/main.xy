导入 std::从UTF8字节;
导入 std::HTTPS响应;
导入 std::获取HTTPS响应;
导入 std::获取必需程序参数;
导入 json::JSON查找对象成员;
导入 json::JSON读取字符串值;
导入 json::JSON读取布尔值;
导入 json::JSON读取数字文本;
导入 json::解析JSON文本;

函数 需要位置(查找结果: 结果<可选<整数>, 字符串>) -> 结果<整数, 字符串> {
    匹配 查找结果 {
        结果::成功(位置) => 匹配 位置 {
            可选::有值(值) => 结果::成功(值),
            可选::空值 => 结果::失败("HTTPS JSON 缺少预期字段"),
        },
        结果::失败(错误) => 结果::失败(错误),
    }
}

函数 主函数() -> 结果<字符串, 字符串> {
    令 响应 = 获取HTTPS响应(获取必需程序参数(0, "缺少 HTTPS JSON 地址")?, 10000)?;
    匹配 响应 {
        HTTPS响应 { 状态码, 最终地址: _, 正文 } => {
            如果 状态码 < 200 或 状态码 >= 300 {
                返回 结果::失败("HTTPS 响应状态不是成功状态");
            }
            令 文本 = 从UTF8字节(正文)?;
            令 项目 = 解析JSON文本(文本)?;
            令 用户编号位置 = 需要位置(JSON查找对象成员(项目, 0, "userId"))?;
            令 任务编号位置 = 需要位置(JSON查找对象成员(项目, 0, "id"))?;
            令 标题位置 = 需要位置(JSON查找对象成员(项目, 0, "title"))?;
            令 完成位置 = 需要位置(JSON查找对象成员(项目, 0, "completed"))?;
            如果 JSON读取数字文本(项目, 用户编号位置)? != "1" 或 JSON读取数字文本(项目, 任务编号位置)? != "1" 或 JSON读取字符串值(项目, 标题位置)? != "delectus aut autem" 或 JSON读取布尔值(项目, 完成位置)? {
                结果::失败("HTTPS JSON 字段不符合预期")
            } 否则 {
                结果::成功("HTTPS JSON 任务通过")
            }
        },
    }
}
