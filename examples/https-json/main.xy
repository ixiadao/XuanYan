导入 std::从UTF8字节;
导入 std::HTTPS响应;
导入 std::列表长度;
导入 std::获取HTTPS响应;
导入 std::获取必需程序参数;
导入 json::解析JSON文本;

函数 主函数() -> 结果<字符串, 字符串> {
    令 响应 = 获取HTTPS响应(获取必需程序参数(0, "缺少 HTTPS JSON 地址")?, 10000)?;
    匹配 响应 {
        HTTPS响应 { 状态码, 正文 } => {
            如果 状态码 < 200 或 状态码 >= 300 {
                返回 结果::失败("HTTPS 响应状态不是成功状态");
            }
            令 文本 = 从UTF8字节(正文)?;
            令 项目 = 解析JSON文本(文本)?;
            如果 列表长度(项目) == 0 {
                结果::失败("HTTPS JSON 响应为空")
            } 否则 {
                结果::成功("HTTPS JSON 通过")
            }
        },
    }
}
