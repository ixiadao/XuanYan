导入 std::读取文本输入;
导入 std::文本分行;
导入 std::文本分割;
导入 std::文本去除首尾空白;
导入 std::文本追加;
导入 std::文本是空;
导入 std::列表;
导入 std::列表长度;
导入 std::列表取出;

结构体 配置汇总 {
    数量: 整数,
    最后键: 字符串,
}

函数 取出字段(字段: 可变借用<列表<字符串>>) -> 结果<字符串, 字符串> {
    匹配 列表取出(字段) {
        可选::有值(值) => 结果::成功(值),
        可选::空值 => 结果::失败("配置字段缺失"),
    }
}

函数 汇总(文本: 字符串) -> 结果<配置汇总, 字符串> {
    变量 汇总 = 配置汇总 { 数量: 0, 最后键: "无" };
    遍历 原始行 在 文本分行(文本) {
        令 行 = 文本去除首尾空白(原始行);
        如果 文本是空(行) {
            继续;
        }
        变量 字段 = 文本分割(行, "=")?;
        令 字段数量 = 列表长度(字段);
        如果 字段数量 < 2 {
            返回 结果::失败("配置记录必须包含一个等号");
        }
        如果 字段数量 > 2 {
            返回 结果::失败("配置记录只能包含一个等号");
        }
        令 键 = 文本去除首尾空白(取出字段(字段)?);
        文本去除首尾空白(取出字段(字段)?);
        如果 文本是空(键) {
            返回 结果::失败("配置键不能为空");
        }
        汇总.数量 = 汇总.数量 + 1;
        汇总.最后键 = 键;
    }
    结果::成功(汇总)
}

函数 生成报告(汇总: 配置汇总) -> 字符串 {
    匹配 汇总 {
        配置汇总 { 数量, 最后键 } => {
            变量 报告 = "配置汇总\n数量：";
            文本追加(报告, 数量.到文本());
            文本追加(报告, "\n最后键：");
            文本追加(报告, 最后键);
            报告
        },
    }
}

函数 主函数() -> 结果<字符串, 字符串> {
    结果::成功(生成报告(汇总(读取文本输入(0)?)?))
}
