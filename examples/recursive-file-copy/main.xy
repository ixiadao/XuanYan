导入 std::创建目录;
导入 std::获取必需程序参数;
导入 std::读取目录;
导入 std::路径连接;
导入 std::路径文件名;
导入 std::路径父目录;
导入 std::路径存在;
导入 std::路径规范化;
导入 std::路径是目录;
导入 std::路径是文件;
导入 std::复制文件;

函数 创建空值() -> 空 {}

函数 路径位于目录内(路径: 字符串, 目录: 借用<字符串>) -> 布尔 {
    如果 路径.到文本() == 目录.到文本() {
        返回 真;
    }
    匹配 路径父目录(路径) {
        结果::成功(父目录) => 路径位于目录内(父目录, 目录),
        结果::失败(_) => 假,
    }
}

函数 已有路径位于目录内(路径: 字符串, 目录: 借用<字符串>) -> 结果<布尔, 字符串> {
    如果 路径存在(路径)? {
        返回 结果::成功(路径位于目录内(路径规范化(路径)?, 目录));
    }
    匹配 路径父目录(路径) {
        结果::成功(父目录) => 已有路径位于目录内(父目录, 目录),
        结果::失败(_) => 结果::成功(假),
    }
}

函数 复制目录树(输入目录: 借用<字符串>, 输出目录: 借用<字符串>) -> 结果<空, 字符串> {
    令 标准输入目录 = 路径规范化(输入目录)?;
    如果 已有路径位于目录内(输出目录.到文本(), 标准输入目录)? {
        返回 结果::失败("输出目录不能与输入目录相同或位于其中");
    }
    令 项目 = 读取目录(输入目录)?;
    创建目录(输出目录)?;
    遍历 输入路径 在 (项目) {
        令 文件名 = 路径文件名(输入路径)?;
        令 输出路径 = 路径连接(输出目录, 文件名);
        令 是文件 = 路径是文件(输入路径)?;
        如果 是文件 {
            复制文件(输入路径, 输出路径)?;
            继续;
        }
        令 是目录 = 路径是目录(输入路径)?;
        如果 非 是目录 {
            继续;
        }
        复制目录树(输入路径, 输出路径)?;
    }
    结果::成功(创建空值())
}

函数 主函数() -> 结果<字符串, 字符串> {
    令 输入目录 = 获取必需程序参数(0, "缺少输入目录")?;
    令 输出目录 = 获取必需程序参数(1, "缺少输出目录")?;
    复制目录树(输入目录, 输出目录)?;
    结果::成功(输出目录)
}
