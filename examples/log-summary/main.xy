导入 std::读取文本输入;
导入 std::文本分行;
导入 std::文本追加;

枚举 日志级别 {
    信息,
    警告,
    错误,
}

结构体 日志统计 {
    信息数: 整数,
    警告数: 整数,
    错误数: 整数,
    最后级别: 字符串,
}

函数 解析级别(行: 字符串) -> 结果<日志级别, 字符串> {
    匹配 行 {
        "信息" => 结果::成功(日志级别::信息),
        "﻿信息" => 结果::成功(日志级别::信息),
        "警告" => 结果::成功(日志级别::警告),
        "﻿警告" => 结果::成功(日志级别::警告),
        "错误" => 结果::成功(日志级别::错误),
        "﻿错误" => 结果::成功(日志级别::错误),
        _ => 结果::失败("未知日志级别"),
    }
}

函数 记录(统计: 可变借用<日志统计>, 级别: 日志级别) -> 空 {
    匹配 级别 {
        日志级别::信息 => {
            统计.信息数 = 统计.信息数 + 1;
            统计.最后级别 = "信息";
        },
        日志级别::警告 => {
            统计.警告数 = 统计.警告数 + 1;
            统计.最后级别 = "警告";
        },
        日志级别::错误 => {
            统计.错误数 = 统计.错误数 + 1;
            统计.最后级别 = "错误";
        },
    }
}

函数 汇总(文本: 字符串) -> 结果<日志统计, 字符串> {
    变量 统计 = 日志统计 { 信息数: 0, 警告数: 0, 错误数: 0, 最后级别: "无" };
    遍历 行 在 文本分行(文本) {
        记录(统计, 解析级别(行)?);
    }
    结果::成功(统计)
}

函数 生成报告(结果值: 结果<日志统计, 字符串>) -> 结果<字符串, 字符串> {
    匹配 结果值 {
        结果::成功(日志统计 { 信息数, 警告数, 错误数, 最后级别 }) => {
            令 总数 = 信息数 + 警告数 + 错误数;
            变量 报告 = "日志汇总\n总数：";
            文本追加(报告, 总数.到文本());
            文本追加(报告, "\n信息：");
            文本追加(报告, 信息数.到文本());
            文本追加(报告, "\n警告：");
            文本追加(报告, 警告数.到文本());
            文本追加(报告, "\n错误：");
            文本追加(报告, 错误数.到文本());
            文本追加(报告, "\n最后：");
            文本追加(报告, 最后级别);
            结果::成功(报告)
        },
        结果::失败(错误) => 结果::失败(错误),
    }
}

函数 主函数() -> 结果<字符串, 字符串> {
    令 文本 = 读取文本输入(0)?;
    生成报告(汇总(文本))
}
