导入 std::获取必需程序参数;
导入 std::读取目录文件;
导入 std::读取文本文件;
导入 std::文本分行;
导入 std::文本追加;

结构体 汇总结果 {
    文件数: 整数,
    记录数: 整数,
    总和: 整数,
}

函数 汇总目录(目录: 字符串) -> 结果<汇总结果, 字符串> {
    变量 汇总 = 汇总结果 { 文件数: 0, 记录数: 0, 总和: 0 };
    遍历 路径 在 读取目录文件(目录)? {
        令 文本 = 读取文本文件(路径)?;
        汇总.文件数 = 汇总.文件数 + 1;
        遍历 行 在 文本分行(文本) {
            汇总.记录数 = 汇总.记录数 + 1;
            汇总.总和 = 汇总.总和 + 整数::从文本(行)?;
        }
    }
    结果::成功(汇总)
}

函数 生成报告(汇总: 汇总结果) -> 字符串 {
    令 文件数 = 汇总.文件数;
    令 记录数 = 汇总.记录数;
    令 总和 = 汇总.总和;
    变量 报告 = "文件数：";
    文本追加(报告, 文件数.到文本());
    文本追加(报告, "\n记录数：");
    文本追加(报告, 记录数.到文本());
    文本追加(报告, "\n总和：");
    文本追加(报告, 总和.到文本());
    报告
}

函数 主函数() -> 结果<字符串, 字符串> {
    结果::成功(生成报告(汇总目录(获取必需程序参数(0, "缺少目录路径")?)?))
}
