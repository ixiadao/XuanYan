{
  "name": "xuanyan",
  "displayName": "玄言",
  "description": "玄言语言的 VS Code 基础支持",
  "version": "0.1.7",
  "publisher": "ixiadao",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "玄言",
    "xuanyan",
    "中文编程"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ixiadao/XuanYan.git"
  },
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "受限工作区只提供语言识别、语法高亮和语言服务，不执行玄言命令。"
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "xuanyan",
        "aliases": [
          "玄言",
          "XuanYan"
        ],
        "extensions": [
          ".xy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xuanyan",
        "scopeName": "source.xuanyan",
        "path": "./syntaxes/xuanyan.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[xuanyan]": {
        "editor.unicodeHighlight.nonBasicASCII": false
      }
    },
    "configuration": {
      "title": "玄言",
      "properties": {
        "xuanyan.toolchain.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "玄言工具链解压目录的绝对路径，其中应包含 bin/xuanyan 和 bin/xuanyan-lsp。留空时从 PATH 查找。"
        }
      }
    },
    "commands": [
      {
        "command": "xuanyan.check",
        "title": "检查",
        "category": "玄言"
      },
      {
        "command": "xuanyan.run",
        "title": "运行",
        "category": "玄言"
      },
      {
        "command": "xuanyan.build",
        "title": "构建",
        "category": "玄言"
      },
      {
        "command": "xuanyan.test",
        "title": "测试",
        "category": "玄言"
      },
      {
        "command": "xuanyan.format",
        "title": "格式化",
        "category": "玄言"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "xuanyan.check",
          "when": "editorLangId == xuanyan && resourceScheme == file",
          "group": "navigation@10"
        },
        {
          "command": "xuanyan.run",
          "when": "editorLangId == xuanyan && resourceScheme == file",
          "group": "navigation@11"
        },
        {
          "command": "xuanyan.build",
          "when": "editorLangId == xuanyan && resourceScheme == file",
          "group": "navigation@12"
        },
        {
          "command": "xuanyan.test",
          "when": "editorLangId == xuanyan && resourceScheme == file",
          "group": "navigation@13"
        },
        {
          "command": "xuanyan.format",
          "when": "editorLangId == xuanyan && resourceScheme == file",
          "group": "navigation@14"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:extension": "node test/run-extension.js",
    "package": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && vsce package --out dist/xuanyan-vscode.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2"
  }
}
