公开 枚举 可选<T> {
    有值(T),
    空值,
}

公开 枚举 结果<T, E> {
    成功(T),
    失败(E),
}

公开 枚举 比较结果 {
    小于,
    相等,
    大于,
}

公开 协议 复制 {
    函数 复制(借用 自身) -> 自身;
}

公开 协议 释放 {
    函数 释放(自身) -> 空;
}

公开 协议 相等 {
    函数 相等(借用 自身, 其他: 借用<自身>) -> 布尔;
}

公开 协议 比较 {
    函数 比较(借用 自身, 其他: 借用<自身>) -> 比较结果;
}

公开 协议 到文本 {
    函数 到文本(借用 自身) -> 字符串;
}

公开 协议 从文本 {
    函数 从文本(文本值: 借用<字符串>) -> 结果<自身, 字符串>;
}

公开 协议 可遍历<T> {
    函数 下一个(可变借用 自身) -> 可选<T>;
}
