导入 std::从UTF8字节;
导入 std::HTTPS响应;
导入 std::列表;
导入 std::列表创建;
导入 std::列表取出;
导入 std::列表追加;
导入 std::删除文件;
导入 std::读取文本文件;
导入 std::写入文本文件;
导入 std::文本包含;
导入 std::获取当前时间;
导入 http::HTTP响应头首值;
导入 http::获取HTTPS客户端响应;
导入 json::JSON查找对象成员;
导入 json::JSON读取字符串值;
导入 json::JSON读取布尔值;
导入 json::JSON读取数字文本;
导入 json::解析JSON文本;

结构体 任务记录 {
    标题: 字符串,
    完成: 布尔,
    同步时间: 整数,
}

枚举 同步状态 {
    已同步(任务记录),
    等待,
}

函数 需要位置(查找结果: 结果<可选<整数>, 字符串>) -> 结果<整数, 字符串> {
    匹配 查找结果 {
        结果::成功(位置) => 匹配 位置 {
            可选::有值(值) => 结果::成功(值),
            可选::空值 => 结果::失败("业务数据缺少预期字段"),
        },
        结果::失败(错误) => 结果::失败(错误),
    }
}

函数 读取任务(文本: 借用<字符串>, 同步时间: 整数) -> 结果<任务记录, 字符串> {
    令 项目 = 解析JSON文本(文本)?;
    令 用户编号位置 = 需要位置(JSON查找对象成员(项目, 0, "userId"))?;
    令 任务编号位置 = 需要位置(JSON查找对象成员(项目, 0, "id"))?;
    令 标题位置 = 需要位置(JSON查找对象成员(项目, 0, "title"))?;
    令 完成位置 = 需要位置(JSON查找对象成员(项目, 0, "completed"))?;
    如果 JSON读取数字文本(项目, 用户编号位置)? != "1" 或 JSON读取数字文本(项目, 任务编号位置)? != "1" {
        返回 结果::失败("业务数据编号不符合预期");
    }
    结果::成功(任务记录 { 标题: JSON读取字符串值(项目, 标题位置)?, 完成: JSON读取布尔值(项目, 完成位置)?, 同步时间 })
}

函数 主函数() -> 结果<字符串, 字符串> {
    令 当前时间 = 获取当前时间();
    如果 当前时间 < 1700000000000 {
        返回 结果::失败("当前时间无效");
    }
    令 响应 = 获取HTTPS客户端响应("https://jsonplaceholder.typicode.com/todos/1", 10000)?;
    匹配 响应 {
        HTTPS响应 { 状态码, 最终地址: _, 响应头, 正文 } => {
            如果 状态码 != 200 {
                返回 结果::失败("业务请求未成功");
            }
            令 内容类型正确 = 匹配 HTTP响应头首值(响应头, "content-type") {
                可选::有值(值) => 文本包含(值, "application/json"),
                可选::空值 => 假,
            };
            如果 非 内容类型正确 {
                返回 结果::失败("业务响应类型无效");
            }
            令 文本 = 从UTF8字节(正文)?;
            令 缓存路径 = "xuanyan-business-state.json";
            写入文本文件(缓存路径, 文本)?;
            令 已保存文本 = 读取文本文件(缓存路径)?;
            删除文件(缓存路径)?;
            变量 当前状态 = 同步状态::等待;
            当前状态 = 同步状态::已同步(读取任务(已保存文本, 当前时间)?);
            变量 任务编号列表: 列表<整数> = 列表创建();
            列表追加(任务编号列表, 1);
            匹配 列表取出(任务编号列表) {
                可选::有值(任务编号) => {
                    如果 任务编号 != 1 {
                        返回 结果::失败("业务任务编号无效");
                    }
                    匹配 当前状态 {
                        同步状态::已同步(任务记录 { 标题, 完成, 同步时间 }) => {
                            如果 标题 == "delectus aut autem" 且 非 完成 且 同步时间 == 当前时间 {
                                结果::成功("玄言四平台同源业务验收通过")
                            } 否则 {
                                结果::失败("业务状态不符合预期")
                            }
                        },
                        同步状态::等待 => 结果::失败("业务仍在等待"),
                    }
                },
                可选::空值 => 结果::失败("业务状态缺失"),
            }
        },
    }
}
