公开 函数 获取必需程序参数(下标: 整数, 错误: 字符串) -> 结果<字符串, 字符串> {
    匹配 获取程序参数(下标) {
        可选::有值(值) => 结果::成功(值),
        可选::空值 => 结果::失败(错误),
    }
}

公开 函数 读取文本输入(下标: 整数) -> 结果<字符串, 字符串> {
    匹配 获取程序参数(下标) {
        可选::有值(路径) => 读取文本文件(路径),
        可选::空值 => 读取标准输入(),
    }
}

公开 函数 列表是空<T>(列表值: 借用<列表<T>>) -> 布尔 {
    列表长度(列表值) == 0
}

公开 函数 列表连接<T>(左: 列表<T>, 右: 列表<T>) -> 列表<T> {
    变量 结果列表 = 左;
    遍历 值 在 (右) {
        列表追加(结果列表, 值);
    }
    结果列表
}

公开 函数 路径是空目录(路径: 借用<字符串>) -> 结果<布尔, 字符串> {
    令 项目 = 读取目录(路径)?;
    结果::成功(列表是空(项目))
}

公开 函数 读取目录文件(目录: 借用<字符串>) -> 结果<列表<字符串>, 字符串> {
    变量 文件列表: 列表<字符串> = 列表创建();
    遍历 路径 在 读取目录(目录)? {
        令 是文件 = 路径是文件(路径)?;
        如果 非 是文件 {
            继续;
        }
        列表追加(文件列表, 路径);
    }
    结果::成功(文件列表)
}

公开 函数 路径扩展名是(路径: 借用<字符串>, 目标扩展名: 借用<字符串>) -> 布尔 {
    匹配 路径扩展名(路径) {
        可选::有值(扩展名) => 文本长度(扩展名) == 文本长度(目标扩展名) 且 文本开头是(扩展名, 目标扩展名),
        可选::空值 => 假,
    }
}

公开 函数 文本连接(左: 字符串, 右: 字符串) -> 字符串 {
    变量 结果文本 = 左;
    文本追加(结果文本, 右);
    结果文本
}

公开 函数 文本到UTF8字节(文本值: 借用<字符串>) -> 结果<列表<字节>, 字符串> {
    变量 字节列表: 列表<字节> = 列表创建();
    变量 下标 = 0;
    当 下标 < 文本字节长度(文本值) {
        匹配 文本字节(文本值, 下标) {
            可选::有值(字节值) => 列表追加(字节列表, 字节值),
            可选::空值 => {
                返回 结果::失败("文本 UTF-8 字节访问不一致");
            },
        };
        下标 = 下标 + 1;
    }
    结果::成功(字节列表)
}

公开 函数 文本是空(文本值: 借用<字符串>) -> 布尔 {
    文本长度(文本值) == 0
}

公开 函数 文本包含(文本值: 借用<字符串>, 片段: 借用<字符串>) -> 布尔 {
    匹配 文本查找(文本值, 片段) {
        可选::有值(_) => 真,
        可选::空值 => 假,
    }
}

公开 函数 文本开头是(文本值: 借用<字符串>, 片段: 借用<字符串>) -> 布尔 {
    匹配 文本查找(文本值, 片段) {
        可选::有值(下标) => 下标 == 0,
        可选::空值 => 假,
    }
}

公开 函数 文本结尾是(文本值: 借用<字符串>, 片段: 借用<字符串>) -> 布尔 {
    令 文本长度值 = 文本长度(文本值);
    令 片段长度 = 文本长度(片段);
    如果 片段长度 > 文本长度值 {
        返回 假;
    }
    匹配 文本截取(文本值, 文本长度值 - 片段长度, 片段长度) {
        可选::有值(末尾) => {
            匹配 文本查找(末尾, 片段) {
                可选::有值(下标) => 下标 == 0,
                可选::空值 => 假,
            }
        },
        可选::空值 => 假,
    }
}

实现<T> 可遍历<T> 为 列表<T> {
    函数 下一个(可变借用 自身) -> 可选<T> {
        列表取出(自身)
    }
}

