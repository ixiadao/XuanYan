导入 src::文本与基础值::文本长度;

函数 创建空值() -> 空 {}

公开 函数 基础值文本正确() -> 布尔 {
    令 空值 = 创建空值();
    如果 空值.到文本() != "空" {
        返回 假;
    }
    令 真值 = 真;
    令 假值 = 假;
    如果 真值.到文本() != "真" 或 假值.到文本() != "假" {
        返回 假;
    }
    令 字符值 = '玄';
    如果 字符值.到文本() != "玄" 或 字符值 != '玄' {
        返回 假;
    }
    令 原文 = "玄言";
    令 文本副本 = 原文.到文本();
    如果 文本副本 != "玄言" 或 原文 != "玄言" {
        返回 假;
    }
    令 整数值: 整数 = -42;
    令 字节值: 字节 = 255;
    令 有符号8值: 有符号8 = -128;
    令 有符号16值: 有符号16 = -32768;
    令 有符号32值: 有符号32 = -2147483648;
    令 有符号64值: 有符号64 = -9223372036854775808;
    令 无符号8值: 无符号8 = 255;
    令 无符号16值: 无符号16 = 65535;
    令 无符号32值: 无符号32 = 4294967295;
    令 无符号64值: 无符号64 = 18446744073709551615;
    如果 整数值.到文本() != "-42" 或 整数值 + 1 != -41 {
        返回 假;
    }
    如果 字节值.到文本() != "255" 或 字节值 != 255 {
        返回 假;
    }
    如果 有符号8值.到文本() != "-128" {
        返回 假;
    }
    如果 有符号16值.到文本() != "-32768" {
        返回 假;
    }
    如果 有符号32值.到文本() != "-2147483648" {
        返回 假;
    }
    如果 有符号64值.到文本() != "-9223372036854775808" {
        返回 假;
    }
    如果 无符号8值.到文本() != "255" {
        返回 假;
    }
    如果 无符号16值.到文本() != "65535" {
        返回 假;
    }
    如果 无符号32值.到文本() != "4294967295" {
        返回 假;
    }
    如果 无符号64值.到文本() != "18446744073709551615" {
        返回 假;
    }
    令 整数小数: 小数 = 42.0;
    令 普通小数: 小数 = 1.5;
    令 正无穷: 小数 = 1.0 / 0.0;
    令 负无穷: 小数 = -1.0 / 0.0;
    令 非数: 小数 = 0.0 / 0.0;
    如果 整数小数.到文本() != "42.0" 或 整数小数 + 1.0 != 43.0 {
        返回 假;
    }
    如果 普通小数.到文本() != "1.5" {
        返回 假;
    }
    如果 正无穷.到文本() != "inf" {
        返回 假;
    }
    如果 负无穷.到文本() != "-inf" {
        返回 假;
    }
    如果 非数.到文本() != "NaN" {
        返回 假;
    }
    真
}

函数 基础值解析成功() -> 结果<布尔, 字符串> {
    令 真文本 = "真";
    令 假文本 = "假";
    令 ASCII字符文本 = "a";
    令 字符文本 = "玄";
    令 有符号8最小文本 = "-128";
    令 有符号8最大文本 = "127";
    令 有符号16最小文本 = "-32768";
    令 有符号16最大文本 = "32767";
    令 有符号32最小文本 = "-2147483648";
    令 有符号32最大文本 = "2147483647";
    令 有符号64最小文本 = "-9223372036854775808";
    令 有符号64最大文本 = "9223372036854775807";
    令 无符号最小文本 = "0";
    令 无符号8最大文本 = "255";
    令 无符号16最大文本 = "65535";
    令 无符号32最大文本 = "4294967295";
    令 无符号64最大文本 = "18446744073709551615";
    令 普通小数文本 = "-1.5";
    令 指数小数文本 = "1e-3";
    令 非数文本 = "NaN";
    令 正无穷文本 = "inf";
    令 负无穷文本 = "-inf";
    令 真值 = 布尔::从文本(真文本)?;
    令 假值 = 布尔::从文本(假文本)?;
    令 ASCII字符值 = 字符::从文本(ASCII字符文本)?;
    令 字符值 = 字符::从文本(字符文本)?;
    令 整数最小 = 整数::从文本(有符号64最小文本)?;
    令 整数最大 = 整数::从文本(有符号64最大文本)?;
    令 字节最小 = 字节::从文本(无符号最小文本)?;
    令 字节最大 = 字节::从文本(无符号8最大文本)?;
    令 有符号8最小 = 有符号8::从文本(有符号8最小文本)?;
    令 有符号8最大 = 有符号8::从文本(有符号8最大文本)?;
    令 有符号16最小 = 有符号16::从文本(有符号16最小文本)?;
    令 有符号16最大 = 有符号16::从文本(有符号16最大文本)?;
    令 有符号32最小 = 有符号32::从文本(有符号32最小文本)?;
    令 有符号32最大 = 有符号32::从文本(有符号32最大文本)?;
    令 有符号64最小 = 有符号64::从文本(有符号64最小文本)?;
    令 有符号64最大 = 有符号64::从文本(有符号64最大文本)?;
    令 无符号8最小 = 无符号8::从文本(无符号最小文本)?;
    令 无符号8最大 = 无符号8::从文本(无符号8最大文本)?;
    令 无符号16最小 = 无符号16::从文本(无符号最小文本)?;
    令 无符号16最大 = 无符号16::从文本(无符号16最大文本)?;
    令 无符号32最小 = 无符号32::从文本(无符号最小文本)?;
    令 无符号32最大 = 无符号32::从文本(无符号32最大文本)?;
    令 无符号64最小 = 无符号64::从文本(无符号最小文本)?;
    令 无符号64最大 = 无符号64::从文本(无符号64最大文本)?;
    令 普通小数 = 小数::从文本(普通小数文本)?;
    令 指数小数 = 小数::从文本(指数小数文本)?;
    令 非数 = 小数::从文本(非数文本)?;
    令 正无穷 = 小数::从文本(正无穷文本)?;
    令 负无穷 = 小数::从文本(负无穷文本)?;
    如果 非 真值 或 假值 或 ASCII字符值 != 'a' 或 字符值 != '玄' {
        返回 结果::成功(假);
    }
    如果 整数最小 != -9223372036854775808 或 整数最大 != 9223372036854775807 {
        返回 结果::成功(假);
    }
    如果 字节最小 != 0 或 字节最大 != 255 {
        返回 结果::成功(假);
    }
    如果 有符号8最小 != -128 或 有符号8最大 != 127 {
        返回 结果::成功(假);
    }
    如果 有符号16最小 != -32768 或 有符号16最大 != 32767 {
        返回 结果::成功(假);
    }
    如果 有符号32最小 != -2147483648 或 有符号32最大 != 2147483647 {
        返回 结果::成功(假);
    }
    如果 有符号64最小 != -9223372036854775808 或 有符号64最大 != 9223372036854775807 {
        返回 结果::成功(假);
    }
    如果 无符号8最小 != 0 或 无符号8最大 != 255 {
        返回 结果::成功(假);
    }
    如果 无符号16最小 != 0 或 无符号16最大 != 65535 {
        返回 结果::成功(假);
    }
    如果 无符号32最小 != 0 或 无符号32最大 != 4294967295 {
        返回 结果::成功(假);
    }
    如果 无符号64最小 != 0 或 无符号64最大 != 18446744073709551615 {
        返回 结果::成功(假);
    }
    如果 普通小数 != -1.5 或 指数小数 != 0.001 {
        返回 结果::成功(假);
    }
    如果 非数.到文本() != "NaN" 或 正无穷.到文本() != "inf" 或 负无穷.到文本() != "-inf" {
        返回 结果::成功(假);
    }
    结果::成功(真)
}

函数 基础值解析失败正确() -> 布尔 {
    令 布尔错误文本 = "true";
    令 空文本 = "";
    令 多字符文本 = "玄言";
    令 有符号8越界文本 = "128";
    令 有符号16越界文本 = "32768";
    令 有符号32越界文本 = "2147483648";
    令 有符号64越界文本 = "9223372036854775808";
    令 无符号8越界文本 = "256";
    令 无符号16越界文本 = "65536";
    令 无符号32越界文本 = "4294967296";
    令 无符号64越界文本 = "18446744073709551616";
    令 空白文本 = " 1";
    令 正号文本 = "+1";
    令 分隔文本 = "1_0";
    令 Unicode数字文本 = "１２";
    令 小数尾点文本 = "1.";
    令 小数正指数文本 = "1e+2";
    令 小数溢出文本 = "1e9999";
    令 布尔失败 = 匹配 布尔::从文本(布尔错误文本) {
        结果::成功(_) => 假,
        结果::失败(错误) => 文本长度(错误) > 0,
    };
    令 空字符失败 = 匹配 字符::从文本(空文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 多字符失败 = 匹配 字符::从文本(多字符文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 整数空失败 = 匹配 整数::从文本(空文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 有符号8越界 = 匹配 有符号8::从文本(有符号8越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 有符号16越界 = 匹配 有符号16::从文本(有符号16越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 有符号32越界 = 匹配 有符号32::从文本(有符号32越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 整数越界 = 匹配 整数::从文本(有符号64越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 有符号64越界 = 匹配 有符号64::从文本(有符号64越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 字节越界 = 匹配 字节::从文本(无符号8越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 无符号8越界 = 匹配 无符号8::从文本(无符号8越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 无符号16越界 = 匹配 无符号16::从文本(无符号16越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 无符号32越界 = 匹配 无符号32::从文本(无符号32越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 无符号64越界 = 匹配 无符号64::从文本(无符号64越界文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 空白失败 = 匹配 整数::从文本(空白文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 正号失败 = 匹配 整数::从文本(正号文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 分隔失败 = 匹配 整数::从文本(分隔文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 Unicode数字失败 = 匹配 整数::从文本(Unicode数字文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 小数尾点失败 = 匹配 小数::从文本(小数尾点文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 小数正指数失败 = 匹配 小数::从文本(小数正指数文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 小数溢出失败 = 匹配 小数::从文本(小数溢出文本) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    布尔失败 且 空字符失败 且 多字符失败 且 整数空失败 且 有符号8越界 且 有符号16越界 且 有符号32越界 且 整数越界 且 有符号64越界 且 字节越界 且 无符号8越界 且 无符号16越界 且 无符号32越界 且 无符号64越界 且 空白失败 且 正号失败 且 分隔失败 且 Unicode数字失败 且 小数尾点失败 且 小数正指数失败 且 小数溢出失败
}

公开 函数 基础值解析正确() -> 布尔 {
    令 成功正确 = 匹配 基础值解析成功() {
        结果::成功(值) => 值,
        结果::失败(_) => 假,
    };
    成功正确 且 基础值解析失败正确()
}
