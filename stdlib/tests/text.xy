函数 下一个文本等于(项目: 可变借用<列表<字符串>>, 预期: 字符串) -> 布尔 {
    匹配 列表取出(项目) {
        可选::有值(值) => 值 == 预期,
        可选::空值 => 假,
    }
}

公开 函数 文本行为正确() -> 布尔 {
    令 文本 = "玄a";
    令 片段 = "玄";
    令 空文本 = "";
    令 中文文本 = "玄言";
    如果 非 文本是空(空文本) 或 文本是空("a") 或 文本是空(中文文本) {
        返回 假;
    }
    如果 空文本 != "" 或 中文文本 != "玄言" {
        返回 假;
    }
    如果 文本长度(文本) != 2 {
        返回 假;
    }
    如果 文本字节长度(文本) != 4 {
        返回 假;
    }
    令 首字符正确 = 匹配 文本字符(文本, 0) {
        可选::有值(值) => 值 == '玄',
        可选::空值 => 假,
    };
    如果 非 首字符正确 {
        返回 假;
    }
    令 次字符正确 = 匹配 文本字符(文本, 1) {
        可选::有值(值) => 值 == 'a',
        可选::空值 => 假,
    };
    如果 非 次字符正确 {
        返回 假;
    }
    令 字符越界 = 匹配 文本字符(文本, 2) {
        可选::有值(_) => 假,
        可选::空值 => 真,
    };
    如果 非 字符越界 {
        返回 假;
    }
    令 首字节正确 = 匹配 文本字节(文本, 0) {
        可选::有值(值) => 值 == 231,
        可选::空值 => 假,
    };
    如果 非 首字节正确 {
        返回 假;
    }
    令 尾字节正确 = 匹配 文本字节(文本, 3) {
        可选::有值(值) => 值 == 97,
        可选::空值 => 假,
    };
    如果 非 尾字节正确 {
        返回 假;
    }
    令 字节越界 = 匹配 文本字节(文本, 4) {
        可选::有值(_) => 假,
        可选::空值 => 真,
    };
    如果 非 字节越界 {
        返回 假;
    }
    如果 非 文本包含(文本, 片段) {
        返回 假;
    }
    令 边界文本 = "😀玄言工具";
    令 开头片段 = "😀玄";
    令 结尾片段 = "言工具";
    如果 非 文本开头是(边界文本, 开头片段) 或 非 文本结尾是(边界文本, 结尾片段) {
        返回 假;
    }
    如果 文本开头是(边界文本, "玄") 或 文本结尾是(边界文本, "言") {
        返回 假;
    }
    如果 非 文本开头是("玄言", "玄言") 或 非 文本结尾是("玄言", "玄言") {
        返回 假;
    }
    如果 非 文本开头是("", "") 或 非 文本结尾是("", "") {
        返回 假;
    }
    如果 文本开头是("", "玄") 或 文本结尾是("", "玄") 或 文本开头是("玄", "玄言") 或 文本结尾是("玄", "玄言") {
        返回 假;
    }
    如果 边界文本 != "😀玄言工具" 或 开头片段 != "😀玄" 或 结尾片段 != "言工具" {
        返回 假;
    }
    令 待去除空白 = " \t　玄 言 \r\n";
    令 去除结果 = 文本去除首尾空白(待去除空白);
    如果 去除结果 != "玄 言" 或 待去除空白 != " \t　玄 言 \r\n" {
        返回 假;
    }
    如果 文本去除首尾空白("") != "" {
        返回 假;
    }
    如果 文本去除首尾空白(" \t\r\n　 ") != "" {
        返回 假;
    }
    如果 文本去除首尾空白("玄言") != "玄言" {
        返回 假;
    }
    令 连接数值: 整数 = 42;
    令 连接结果 = 文本连接("总和：", 连接数值.到文本());
    如果 连接结果 != "总和：42" {
        返回 假;
    }
    如果 文本连接("", "玄言") != "玄言" 或 文本连接("玄言", "") != "玄言" {
        返回 假;
    }
    变量 输出 = "";
    令 标题 = "总和：";
    令 数值: 整数 = 42;
    令 数值文本 = 数值.到文本();
    令 换行 = "\n";
    文本追加(输出, 标题);
    文本追加(输出, 数值文本);
    文本追加(输出, 换行);
    令 空片段 = "";
    文本追加(输出, 空片段);
    输出 == "总和：42\n"
}

公开 函数 文本大小写转换行为正确() -> 布尔 {
    令 原文本 = "XuanYan玄言";
    令 小写正确 = 文本转为小写(原文本) == "xuanyan玄言";
    令 大写正确 = 文本转为大写(原文本) == "XUANYAN玄言";
    原文本 == "XuanYan玄言" 且 小写正确 且 大写正确 且 文本转为大写("ß") == "SS" 且 文本转为小写("") == "" 且 文本转为大写("") == ""
}

公开 函数 文本到UTF8字节行为正确() -> 布尔 {
    匹配 文本到UTF8字节("玄a") {
        结果::失败(_) => 假,
        结果::成功(字节列表) => {
            变量 内容 = 字节列表;
            令 第一项正确 = 匹配 列表取出(内容) {
                可选::有值(值) => 值 == 231,
                可选::空值 => 假,
            };
            令 第二项正确 = 匹配 列表取出(内容) {
                可选::有值(值) => 值 == 142,
                可选::空值 => 假,
            };
            令 第三项正确 = 匹配 列表取出(内容) {
                可选::有值(值) => 值 == 132,
                可选::空值 => 假,
            };
            令 第四项正确 = 匹配 列表取出(内容) {
                可选::有值(值) => 值 == 97,
                可选::空值 => 假,
            };
            第一项正确 且 第二项正确 且 第三项正确 且 第四项正确 且 列表长度(内容) == 0
        },
    }
}

公开 函数 文本分割行为正确() -> 布尔 {
    令 原文 = "a,b,c";
    令 分隔符 = ",";
    令 普通字段正确 = 匹配 文本分割(原文, 分隔符) {
        结果::成功(字段) => {
            变量 项目 = 字段;
            列表长度(项目) == 3 且 下一个文本等于(项目, "a") 且 下一个文本等于(项目, "b") 且 下一个文本等于(项目, "c")
        },
        结果::失败(_) => 假,
    };
    如果 非 普通字段正确 或 原文 != "a,b,c" 或 分隔符 != "," {
        返回 假;
    }
    令 中文字段正确 = 匹配 文本分割("玄言分隔规则", "分隔") {
        结果::成功(字段) => {
            变量 项目 = 字段;
            列表长度(项目) == 2 且 下一个文本等于(项目, "玄言") 且 下一个文本等于(项目, "规则")
        },
        结果::失败(_) => 假,
    };
    如果 非 中文字段正确 {
        返回 假;
    }
    令 连续分隔符正确 = 匹配 文本分割("a,,c", ",") {
        结果::成功(字段) => {
            变量 项目 = 字段;
            列表长度(项目) == 3 且 下一个文本等于(项目, "a") 且 下一个文本等于(项目, "") 且 下一个文本等于(项目, "c")
        },
        结果::失败(_) => 假,
    };
    如果 非 连续分隔符正确 {
        返回 假;
    }
    令 首尾分隔符正确 = 匹配 文本分割(",a,", ",") {
        结果::成功(字段) => {
            变量 项目 = 字段;
            列表长度(项目) == 3 且 下一个文本等于(项目, "") 且 下一个文本等于(项目, "a") 且 下一个文本等于(项目, "")
        },
        结果::失败(_) => 假,
    };
    如果 非 首尾分隔符正确 {
        返回 假;
    }
    令 无分隔符正确 = 匹配 文本分割("玄言", "|") {
        结果::成功(字段) => {
            变量 项目 = 字段;
            列表长度(项目) == 1 且 下一个文本等于(项目, "玄言")
        },
        结果::失败(_) => 假,
    };
    如果 非 无分隔符正确 {
        返回 假;
    }
    令 空输入正确 = 匹配 文本分割("", ",") {
        结果::成功(字段) => {
            变量 项目 = 字段;
            列表长度(项目) == 1 且 下一个文本等于(项目, "")
        },
        结果::失败(_) => 假,
    };
    如果 非 空输入正确 {
        返回 假;
    }
    匹配 文本分割("玄言", "") {
        结果::成功(_) => 假,
        结果::失败(错误) => 文本长度(错误) > 0,
    }
}

公开 函数 文本替换行为正确() -> 布尔 {
    令 原文 = "a-b-a";
    令 原片段 = "a";
    令 新片段 = "x";
    令 普通替换正确 = 匹配 文本替换(原文, 原片段, 新片段) {
        结果::成功(文本) => 文本 == "x-b-x",
        结果::失败(_) => 假,
    };
    如果 非 普通替换正确 或 原文 != "a-b-a" 或 原片段 != "a" 或 新片段 != "x" {
        返回 假;
    }
    令 中文替换正确 = 匹配 文本替换("玄言语言", "语言", "工具") {
        结果::成功(文本) => 文本 == "玄言工具",
        结果::失败(_) => 假,
    };
    令 重复替换正确 = 匹配 文本替换("a-a-a", "a", "b") {
        结果::成功(文本) => 文本 == "b-b-b",
        结果::失败(_) => 假,
    };
    令 重叠替换正确 = 匹配 文本替换("aaaa", "aa", "b") {
        结果::成功(文本) => 文本 == "bb",
        结果::失败(_) => 假,
    };
    令 未命中正确 = 匹配 文本替换("玄言", "不存在", "替换") {
        结果::成功(文本) => 文本 == "玄言",
        结果::失败(_) => 假,
    };
    令 删除正确 = 匹配 文本替换("a-b-a", "a", "") {
        结果::成功(文本) => 文本 == "-b-",
        结果::失败(_) => 假,
    };
    如果 非 中文替换正确 或 非 重复替换正确 或 非 重叠替换正确 或 非 未命中正确 或 非 删除正确 {
        返回 假;
    }
    匹配 文本替换("玄言", "", "替换") {
        结果::成功(_) => 假,
        结果::失败(错误) => 文本长度(错误) > 0,
    }
}

公开 函数 文本查找行为正确() -> 布尔 {
    令 文本 = "玄言-a-玄言";
    令 片段 = "a";
    令 普通查找正确 = 匹配 文本查找(文本, 片段) {
        可选::有值(下标) => 下标 == 3,
        可选::空值 => 假,
    };
    如果 非 普通查找正确 或 文本 != "玄言-a-玄言" 或 片段 != "a" {
        返回 假;
    }
    令 中文查找正确 = 匹配 文本查找("a玄言", "玄") {
        可选::有值(下标) => 下标 == 1,
        可选::空值 => 假,
    };
    令 重复查找正确 = 匹配 文本查找("a-a-a", "a") {
        可选::有值(下标) => 下标 == 0,
        可选::空值 => 假,
    };
    令 未命中正确 = 匹配 文本查找("玄言", "工具") {
        可选::有值(_) => 假,
        可选::空值 => 真,
    };
    令 空片段正确 = 匹配 文本查找("玄言", "") {
        可选::有值(下标) => 下标 == 0,
        可选::空值 => 假,
    };
    令 包含文本 = "前玄言后";
    令 包含片段 = "玄言";
    令 包含正确 = 文本包含(包含文本, 包含片段) 且 非 文本包含("玄言", "工具") 且 文本包含("玄言", "");
    中文查找正确 且 重复查找正确 且 未命中正确 且 空片段正确 且 包含正确 且 包含文本 == "前玄言后" 且 包含片段 == "玄言"
}

公开 函数 文本截取行为正确() -> 布尔 {
    令 文本 = "a玄言b";
    令 中文截取正确 = 匹配 文本截取(文本, 1, 2) {
        可选::有值(片段) => 片段 == "玄言",
        可选::空值 => 假,
    };
    令 ASCII截取正确 = 匹配 文本截取("abcdef", 1, 3) {
        可选::有值(片段) => 片段 == "bcd",
        可选::空值 => 假,
    };
    令 末尾空片段正确 = 匹配 文本截取("玄言", 2, 0) {
        可选::有值(片段) => 片段 == "",
        可选::空值 => 假,
    };
    令 空文本正确 = 匹配 文本截取("", 0, 0) {
        可选::有值(片段) => 片段 == "",
        可选::空值 => 假,
    };
    令 负开始下标正确 = 匹配 文本截取("玄言", -1, 1) {
        可选::有值(_) => 假,
        可选::空值 => 真,
    };
    令 负字符数量正确 = 匹配 文本截取("玄言", 0, -1) {
        可选::有值(_) => 假,
        可选::空值 => 真,
    };
    令 开始越界正确 = 匹配 文本截取("玄言", 3, 0) {
        可选::有值(_) => 假,
        可选::空值 => 真,
    };
    令 范围越界正确 = 匹配 文本截取("玄言", 1, 2) {
        可选::有值(_) => 假,
        可选::空值 => 真,
    };
    文本 == "a玄言b" 且 中文截取正确 且 ASCII截取正确 且 末尾空片段正确 且 空文本正确 且 负开始下标正确 且 负字符数量正确 且 开始越界正确 且 范围越界正确
}
