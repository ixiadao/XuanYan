导入 std::从UTF8字节;
导入 std::列表;
导入 std::列表创建;
导入 std::列表追加;
导入 std::列表取出;
导入 std::列表长度;
导入 std::文本字节;
导入 std::文本字节长度;
导入 std::文本截取;
导入 std::文本长度;
导入 std::文本开头是;
导入 std::文本追加;

函数 创建空值() -> 空 {}

函数 JSON错误(位置: 整数, 原因: 借用<字符串>) -> 字符串 {
    变量 错误 = "JSON 字节 ";
    文本追加(错误, 位置.到文本());
    文本追加(错误, "：");
    文本追加(错误, 原因);
    错误
}

函数 JSON创建项(标记: 字符串, 内容: 字符串) -> 字符串 {
    变量 项 = 标记;
    文本追加(项, 内容);
    项
}

函数 JSON验证数字文本(文本值: 借用<字符串>) -> 结果<空, 字符串> {
    变量 位置 = 0;
    JSON解析数字(文本值, 位置)?;
    如果 位置 != 文本字节长度(文本值) {
        返回 结果::失败(JSON错误(位置, "数字后存在多余内容"));
    }
    结果::成功(创建空值())
}

公开 函数 JSON创建空值项() -> 字符串 {
    "0"
}

公开 函数 JSON创建布尔项(值: 布尔) -> 字符串 {
    如果 值 {
        "btrue"
    } 否则 {
        "bfalse"
    }
}

公开 函数 JSON创建数字项(文本值: 字符串) -> 结果<字符串, 字符串> {
    JSON验证数字文本(文本值)?;
    结果::成功(JSON创建项("n", 文本值))
}

公开 函数 JSON创建字符串项(文本值: 字符串) -> 字符串 {
    JSON创建项("s", 文本值)
}

公开 函数 JSON创建数组开始项() -> 字符串 {
    "["
}

公开 函数 JSON创建数组结束项() -> 字符串 {
    "]"
}

公开 函数 JSON创建对象开始项() -> 字符串 {
    "{"
}

公开 函数 JSON创建对象成员项(名称: 字符串) -> 字符串 {
    JSON创建项("k", 名称)
}

公开 函数 JSON创建对象结束项() -> 字符串 {
    "}"
}

函数 JSON项有效(项: 借用<字符串>) -> 布尔 {
    令 长度 = 文本长度(项);
    如果 长度 == 0 {
        返回 假;
    }
    令 标记 = 匹配 文本字节(项, 0) {
        可选::有值(值) => 值,
        可选::空值 => 255,
    };
    标记 == 48 且 长度 == 1 或 标记 == 98 且 (长度 == 5 且 文本开头是(项, "btrue") 或 长度 == 6 且 文本开头是(项, "bfalse")) 或 标记 == 110 且 长度 > 1 或 标记 == 115 或 标记 == 91 且 长度 == 1 或 标记 == 93 且 长度 == 1 或 标记 == 123 且 长度 == 1 或 标记 == 107 或 标记 == 125 且 长度 == 1
}

公开 函数 JSON项类型(项: 借用<字符串>) -> 结果<字符串, 字符串> {
    如果 非 JSON项有效(项) {
        返回 结果::失败("JSON 项类型标记无效");
    }
    令 标记 = 匹配 文本字节(项, 0) {
        可选::有值(值) => 值,
        可选::空值 => 255,
    };
    如果 标记 == 48 {
        返回 结果::成功("空值");
    }
    如果 标记 == 98 {
        返回 结果::成功("布尔值");
    }
    如果 标记 == 110 {
        返回 结果::成功("数字值");
    }
    如果 标记 == 115 {
        返回 结果::成功("字符串值");
    }
    如果 标记 == 91 {
        返回 结果::成功("数组开始");
    }
    如果 标记 == 93 {
        返回 结果::成功("数组结束");
    }
    如果 标记 == 123 {
        返回 结果::成功("对象开始");
    }
    如果 标记 == 107 {
        返回 结果::成功("对象成员");
    }
    如果 标记 == 125 {
        返回 结果::成功("对象结束");
    }
    结果::失败("JSON 项类型标记无效")
}

公开 函数 JSON项文本(项: 借用<字符串>) -> 结果<字符串, 字符串> {
    如果 非 JSON项有效(项) {
        返回 结果::失败("JSON 项类型标记无效");
    }
    令 长度 = 文本长度(项);
    如果 长度 == 1 {
        返回 结果::成功("");
    }
    匹配 文本截取(项, 1, 长度 - 1) {
        可选::有值(文本值) => 结果::成功(文本值),
        可选::空值 => 结果::失败("JSON 项文本边界无效"),
    }
}

函数 JSON读取字节(文本值: 借用<字符串>, 位置: 整数) -> 结果<字节, 字符串> {
    匹配 文本字节(文本值, 位置) {
        可选::有值(值) => 结果::成功(值),
        可选::空值 => 结果::失败(JSON错误(位置, "意外到达输入末尾")),
    }
}

函数 JSON当前是(文本值: 借用<字符串>, 位置: 整数, 目标: 字节) -> 布尔 {
    匹配 文本字节(文本值, 位置) {
        可选::有值(值) => 值 == 目标,
        可选::空值 => 假,
    }
}

函数 JSON是数字(值: 字节) -> 布尔 {
    值 >= 48 且 值 <= 57
}

函数 JSON前进(位置: 可变借用<整数>, 数量: 整数) -> 空 {
    令 新位置 = *位置 + 数量;
    *位置 = 新位置;
}

函数 JSON跳过空白(文本值: 借用<字符串>, 位置: 可变借用<整数>) -> 空 {
    令 长度 = 文本字节长度(文本值);
    当 *位置 < 长度 {
        令 值 = 匹配 文本字节(文本值, *位置) {
            可选::有值(当前值) => 当前值,
            可选::空值 => 0,
        };
        如果 值 != 32 且 值 != 9 且 值 != 10 且 值 != 13 {
            返回;
        }
        JSON前进(位置, 1);
    }
}

函数 JSON添加项(输出: 可变借用<列表<字符串>>, 项: 字符串, 位置: 整数, 项数量: 可变借用<整数>) -> 结果<空, 字符串> {
    如果 *项数量 >= 4096 {
        返回 结果::失败(JSON错误(位置, "结果项数量超过 4096"));
    }
    列表追加(输出, 项);
    JSON前进(项数量, 1);
    结果::成功(创建空值())
}

函数 JSON消费固定文本(文本值: 借用<字符串>, 位置: 可变借用<整数>, 目标: 借用<字符串>) -> 结果<空, 字符串> {
    变量 下标 = 0;
    令 目标长度 = 文本字节长度(目标);
    当 下标 < 目标长度 {
        如果 JSON读取字节(文本值, *位置 + 下标)? != JSON读取字节(目标, 下标)? {
            返回 结果::失败(JSON错误(*位置, "无效字面量"));
        }
        下标 = 下标 + 1;
    }
    JSON前进(位置, 目标长度);
    结果::成功(创建空值())
}

函数 JSON追加字节(输出: 可变借用<列表<字节>>, 值: 整数, 位置: 整数) -> 结果<空, 字符串> {
    匹配 字节::从文本(值.到文本()) {
        结果::成功(字节值) => {
            列表追加(输出, 字节值);
            结果::成功(创建空值())
        },
        结果::失败(_) => 结果::失败(JSON错误(位置, "无法构造 UTF-8 字节")),
    }
}

函数 JSON追加码点(输出: 可变借用<列表<字节>>, 码点: 整数, 位置: 整数) -> 结果<空, 字符串> {
    如果 码点 < 0 或 码点 > 1114111 或 码点 >= 55296 且 码点 <= 57343 {
        返回 结果::失败(JSON错误(位置, "Unicode 转义不是有效码点"));
    }
    如果 码点 <= 127 {
        JSON追加字节(输出, 码点, 位置)?;
    } 否则 如果 码点 <= 2047 {
        JSON追加字节(输出, 192 + 码点 / 64, 位置)?;
        JSON追加字节(输出, 128 + 码点 % 64, 位置)?;
    } 否则 如果 码点 <= 65535 {
        JSON追加字节(输出, 224 + 码点 / 4096, 位置)?;
        JSON追加字节(输出, 128 + 码点 / 64 % 64, 位置)?;
        JSON追加字节(输出, 128 + 码点 % 64, 位置)?;
    } 否则 {
        JSON追加字节(输出, 240 + 码点 / 262144, 位置)?;
        JSON追加字节(输出, 128 + 码点 / 4096 % 64, 位置)?;
        JSON追加字节(输出, 128 + 码点 / 64 % 64, 位置)?;
        JSON追加字节(输出, 128 + 码点 % 64, 位置)?;
    };
    结果::成功(创建空值())
}

函数 JSON十六进制值(值: 字节) -> 整数 {
    令 整数值 = 匹配 整数::从文本(值.到文本()) {
        结果::成功(结果值) => 结果值,
        结果::失败(_) => -1,
    };
    如果 整数值 >= 48 且 整数值 <= 57 {
        返回 整数值 - 48;
    }
    如果 整数值 >= 65 且 整数值 <= 70 {
        返回 整数值 - 55;
    }
    如果 整数值 >= 97 且 整数值 <= 102 {
        返回 整数值 - 87;
    }
    返回 -1;
}

函数 JSON解析四位十六进制(文本值: 借用<字符串>, 位置: 可变借用<整数>) -> 结果<整数, 字符串> {
    变量 数量 = 0;
    变量 结果值 = 0;
    当 数量 < 4 {
        令 当前值 = JSON读取字节(文本值, *位置)?;
        令 数字值 = JSON十六进制值(当前值);
        如果 数字值 < 0 {
            返回 结果::失败(JSON错误(*位置, "Unicode 转义必须包含四位十六进制数字"));
        }
        结果值 = 结果值 * 16 + 数字值;
        JSON前进(位置, 1);
        数量 = 数量 + 1;
    }
    结果::成功(结果值)
}

函数 JSON解析字符串(文本值: 借用<字符串>, 位置: 可变借用<整数>) -> 结果<字符串, 字符串> {
    令 开始位置 = *位置;
    如果 非 JSON当前是(文本值, *位置, 34) {
        返回 结果::失败(JSON错误(*位置, "字符串缺少开始引号"));
    }
    JSON前进(位置, 1);
    变量 内容: 列表<字节> = 列表创建();
    当 *位置 < 文本字节长度(文本值) {
        令 当前位置 = *位置;
        令 当前值 = JSON读取字节(文本值, 当前位置)?;
        如果 当前值 == 34 {
            JSON前进(位置, 1);
            返回 匹配 从UTF8字节(内容) {
                结果::成功(结果值) => 结果::成功(结果值),
                结果::失败(_) => 结果::失败(JSON错误(开始位置, "字符串不是有效 UTF-8")),
            };
        }
        如果 当前值 < 32 {
            返回 结果::失败(JSON错误(当前位置, "字符串包含未转义控制字符"));
        }
        如果 当前值 != 92 {
            列表追加(内容, 当前值);
            JSON前进(位置, 1);
            继续;
        }
        JSON前进(位置, 1);
        令 转义位置 = *位置;
        令 转义值 = JSON读取字节(文本值, 转义位置)?;
        JSON前进(位置, 1);
        如果 转义值 == 34 或 转义值 == 92 或 转义值 == 47 {
            列表追加(内容, 转义值);
            继续;
        }
        如果 转义值 == 98 {
            JSON追加字节(内容, 8, 转义位置)?;
            继续;
        }
        如果 转义值 == 102 {
            JSON追加字节(内容, 12, 转义位置)?;
            继续;
        }
        如果 转义值 == 110 {
            JSON追加字节(内容, 10, 转义位置)?;
            继续;
        }
        如果 转义值 == 114 {
            JSON追加字节(内容, 13, 转义位置)?;
            继续;
        }
        如果 转义值 == 116 {
            JSON追加字节(内容, 9, 转义位置)?;
            继续;
        }
        如果 转义值 != 117 {
            返回 结果::失败(JSON错误(转义位置, "字符串包含未知转义"));
        }
        变量 码点 = JSON解析四位十六进制(文本值, 位置)?;
        如果 码点 >= 55296 且 码点 <= 56319 {
            如果 非 JSON当前是(文本值, *位置, 92) 或 非 JSON当前是(文本值, *位置 + 1, 117) {
                返回 结果::失败(JSON错误(*位置, "高代理项后缺少低代理项"));
            }
            JSON前进(位置, 2);
            令 低代理项位置 = *位置;
            令 低代理项 = JSON解析四位十六进制(文本值, 位置)?;
            如果 低代理项 < 56320 或 低代理项 > 57343 {
                返回 结果::失败(JSON错误(低代理项位置, "高代理项后必须是低代理项"));
            }
            码点 = 65536 + (码点 - 55296) * 1024 + 低代理项 - 56320;
        }
        如果 码点 >= 56320 且 码点 <= 57343 {
            返回 结果::失败(JSON错误(转义位置, "低代理项前缺少高代理项"));
        }
        JSON追加码点(内容, 码点, 转义位置)?;
    }
    结果::失败(JSON错误(*位置, "字符串缺少结束引号"))
}

函数 JSON解析数字(文本值: 借用<字符串>, 位置: 可变借用<整数>) -> 结果<字符串, 字符串> {
    令 开始位置 = *位置;
    变量 内容: 列表<字节> = 列表创建();
    如果 JSON当前是(文本值, *位置, 45) {
        列表追加(内容, JSON读取字节(文本值, *位置)?);
        JSON前进(位置, 1);
    }
    令 首位 = JSON读取字节(文本值, *位置)?;
    如果 首位 == 48 {
        列表追加(内容, 首位);
        JSON前进(位置, 1);
        匹配 文本字节(文本值, *位置) {
            可选::有值(下一位) => {
                如果 JSON是数字(下一位) {
                    返回 结果::失败(JSON错误(*位置, "数字不能包含前导零"));
                }
            },
            可选::空值 => {},
        };
    } 否则 如果 首位 >= 49 且 首位 <= 57 {
        当 *位置 < 文本字节长度(文本值) {
            令 当前值 = JSON读取字节(文本值, *位置)?;
            如果 非 JSON是数字(当前值) {
                跳出;
            }
            列表追加(内容, 当前值);
            JSON前进(位置, 1);
        }
    } 否则 {
        返回 结果::失败(JSON错误(*位置, "数字缺少整数部分"));
    };
    如果 JSON当前是(文本值, *位置, 46) {
        列表追加(内容, JSON读取字节(文本值, *位置)?);
        JSON前进(位置, 1);
        令 小数开始 = *位置;
        当 *位置 < 文本字节长度(文本值) {
            令 当前值 = JSON读取字节(文本值, *位置)?;
            如果 非 JSON是数字(当前值) {
                跳出;
            }
            列表追加(内容, 当前值);
            JSON前进(位置, 1);
        }
        如果 *位置 == 小数开始 {
            返回 结果::失败(JSON错误(*位置, "小数点后缺少数字"));
        }
    }
    如果 JSON当前是(文本值, *位置, 101) 或 JSON当前是(文本值, *位置, 69) {
        列表追加(内容, JSON读取字节(文本值, *位置)?);
        JSON前进(位置, 1);
        如果 JSON当前是(文本值, *位置, 43) 或 JSON当前是(文本值, *位置, 45) {
            列表追加(内容, JSON读取字节(文本值, *位置)?);
            JSON前进(位置, 1);
        }
        令 指数开始 = *位置;
        当 *位置 < 文本字节长度(文本值) {
            令 当前值 = JSON读取字节(文本值, *位置)?;
            如果 非 JSON是数字(当前值) {
                跳出;
            }
            列表追加(内容, 当前值);
            JSON前进(位置, 1);
        }
        如果 *位置 == 指数开始 {
            返回 结果::失败(JSON错误(*位置, "指数部分缺少数字"));
        }
    }
    匹配 从UTF8字节(内容) {
        结果::成功(结果值) => 结果::成功(结果值),
        结果::失败(_) => 结果::失败(JSON错误(开始位置, "数字文本不是有效 UTF-8")),
    }
}

函数 JSON解析值(文本值: 借用<字符串>, 位置: 可变借用<整数>, 深度: 整数, 输出: 可变借用<列表<字符串>>, 项数量: 可变借用<整数>) -> 结果<空, 字符串> {
    JSON跳过空白(文本值, 位置);
    令 当前位置 = *位置;
    令 当前值 = JSON读取字节(文本值, 当前位置)?;
    如果 当前值 == 110 {
        JSON消费固定文本(文本值, 位置, "null")?;
        返回 JSON添加项(输出, "0", 当前位置, 项数量);
    }
    如果 当前值 == 116 {
        JSON消费固定文本(文本值, 位置, "true")?;
        返回 JSON添加项(输出, "btrue", 当前位置, 项数量);
    }
    如果 当前值 == 102 {
        JSON消费固定文本(文本值, 位置, "false")?;
        返回 JSON添加项(输出, "bfalse", 当前位置, 项数量);
    }
    如果 当前值 == 34 {
        令 字符串值 = JSON解析字符串(文本值, 位置)?;
        返回 JSON添加项(输出, JSON创建项("s", 字符串值), 当前位置, 项数量);
    }
    如果 当前值 == 91 {
        返回 JSON解析数组(文本值, 位置, 深度, 输出, 项数量);
    }
    如果 当前值 == 123 {
        返回 JSON解析对象(文本值, 位置, 深度, 输出, 项数量);
    }
    如果 当前值 == 45 或 JSON是数字(当前值) {
        令 数字值 = JSON解析数字(文本值, 位置)?;
        返回 JSON添加项(输出, JSON创建项("n", 数字值), 当前位置, 项数量);
    }
    结果::失败(JSON错误(当前位置, "不是有效 JSON 值"))
}

函数 JSON解析数组(文本值: 借用<字符串>, 位置: 可变借用<整数>, 深度: 整数, 输出: 可变借用<列表<字符串>>, 项数量: 可变借用<整数>) -> 结果<空, 字符串> {
    如果 深度 >= 128 {
        返回 结果::失败(JSON错误(*位置, "容器嵌套深度超过 128"));
    }
    令 开始位置 = *位置;
    JSON前进(位置, 1);
    JSON添加项(输出, "[", 开始位置, 项数量)?;
    JSON跳过空白(文本值, 位置);
    如果 JSON当前是(文本值, *位置, 93) {
        JSON前进(位置, 1);
        返回 JSON添加项(输出, "]", *位置 - 1, 项数量);
    }
    循环 {
        JSON解析值(文本值, 位置, 深度 + 1, 输出, 项数量)?;
        JSON跳过空白(文本值, 位置);
        如果 JSON当前是(文本值, *位置, 93) {
            JSON前进(位置, 1);
            返回 JSON添加项(输出, "]", *位置 - 1, 项数量);
        }
        如果 非 JSON当前是(文本值, *位置, 44) {
            返回 结果::失败(JSON错误(*位置, "数组元素后缺少逗号或结束括号"));
        }
        JSON前进(位置, 1);
        JSON跳过空白(文本值, 位置);
        如果 JSON当前是(文本值, *位置, 93) {
            返回 结果::失败(JSON错误(*位置, "数组末项后不能有逗号"));
        }
    }
    结果::失败(JSON错误(*位置, "数组缺少结束括号"))
}

函数 JSON解析对象(文本值: 借用<字符串>, 位置: 可变借用<整数>, 深度: 整数, 输出: 可变借用<列表<字符串>>, 项数量: 可变借用<整数>) -> 结果<空, 字符串> {
    如果 深度 >= 128 {
        返回 结果::失败(JSON错误(*位置, "容器嵌套深度超过 128"));
    }
    令 开始位置 = *位置;
    JSON前进(位置, 1);
    JSON添加项(输出, "{", 开始位置, 项数量)?;
    JSON跳过空白(文本值, 位置);
    如果 JSON当前是(文本值, *位置, 125) {
        JSON前进(位置, 1);
        返回 JSON添加项(输出, "}", *位置 - 1, 项数量);
    }
    循环 {
        如果 非 JSON当前是(文本值, *位置, 34) {
            返回 结果::失败(JSON错误(*位置, "对象成员名必须是字符串"));
        }
        令 成员位置 = *位置;
        令 成员名 = JSON解析字符串(文本值, 位置)?;
        JSON添加项(输出, JSON创建项("k", 成员名), 成员位置, 项数量)?;
        JSON跳过空白(文本值, 位置);
        如果 非 JSON当前是(文本值, *位置, 58) {
            返回 结果::失败(JSON错误(*位置, "对象成员名后缺少冒号"));
        }
        JSON前进(位置, 1);
        JSON解析值(文本值, 位置, 深度 + 1, 输出, 项数量)?;
        JSON跳过空白(文本值, 位置);
        如果 JSON当前是(文本值, *位置, 125) {
            JSON前进(位置, 1);
            返回 JSON添加项(输出, "}", *位置 - 1, 项数量);
        }
        如果 非 JSON当前是(文本值, *位置, 44) {
            返回 结果::失败(JSON错误(*位置, "对象成员后缺少逗号或结束括号"));
        }
        JSON前进(位置, 1);
        JSON跳过空白(文本值, 位置);
        如果 JSON当前是(文本值, *位置, 125) {
            返回 结果::失败(JSON错误(*位置, "对象末项后不能有逗号"));
        }
    }
    结果::失败(JSON错误(*位置, "对象缺少结束括号"))
}

公开 函数 解析JSON文本(文本值: 借用<字符串>) -> 结果<列表<字符串>, 字符串> {
    令 输入字节数 = 文本字节长度(文本值);
    如果 输入字节数 > 1048576 {
        返回 结果::失败(JSON错误(1048576, "输入超过 1048576 个 UTF-8 字节"));
    }
    变量 位置 = 0;
    变量 输出: 列表<字符串> = 列表创建();
    变量 项数量 = 0;
    JSON跳过空白(文本值, 位置);
    如果 位置 == 输入字节数 {
        返回 结果::失败(JSON错误(位置, "缺少 JSON 值"));
    }
    JSON解析值(文本值, 位置, 0, 输出, 项数量)?;
    JSON跳过空白(文本值, 位置);
    如果 位置 != 输入字节数 {
        返回 结果::失败(JSON错误(位置, "JSON 值后存在多余内容"));
    }
    结果::成功(输出)
}

函数 JSON生成错误(项位置: 整数, 原因: 借用<字符串>) -> 字符串 {
    变量 错误 = "JSON 项 ";
    文本追加(错误, 项位置.到文本());
    文本追加(错误, "：");
    文本追加(错误, 原因);
    错误
}

函数 JSON生成追加字节(输出: 可变借用<列表<字节>>, 输出字节数: 可变借用<整数>, 值: 字节, 项位置: 整数) -> 结果<空, 字符串> {
    如果 *输出字节数 >= 1048576 {
        返回 结果::失败(JSON生成错误(项位置, "输出超过 1048576 个 UTF-8 字节"));
    }
    列表追加(输出, 值);
    令 新字节数 = *输出字节数 + 1;
    *输出字节数 = 新字节数;
    结果::成功(创建空值())
}

函数 JSON生成读取字节(文本值: 借用<字符串>, 位置: 整数, 项位置: 整数) -> 结果<字节, 字符串> {
    匹配 文本字节(文本值, 位置) {
        可选::有值(值) => 结果::成功(值),
        可选::空值 => 结果::失败(JSON生成错误(项位置, "文本字节边界无效")),
    }
}

函数 JSON生成追加文本(输出: 可变借用<列表<字节>>, 输出字节数: 可变借用<整数>, 文本值: 借用<字符串>, 项位置: 整数) -> 结果<空, 字符串> {
    变量 位置 = 0;
    令 长度 = 文本字节长度(文本值);
    当 位置 < 长度 {
        令 值 = JSON生成读取字节(文本值, 位置, 项位置)?;
        JSON生成追加字节(输出, 输出字节数, 值, 项位置)?;
        位置 = 位置 + 1;
    }
    结果::成功(创建空值())
}

函数 JSON十六进制字节(值: 整数) -> 字节 {
    匹配 文本字节("0123456789abcdef", 值) {
        可选::有值(结果值) => 结果值,
        可选::空值 => 48,
    }
}

函数 JSON生成追加字符串(输出: 可变借用<列表<字节>>, 输出字节数: 可变借用<整数>, 文本值: 借用<字符串>, 项位置: 整数) -> 结果<空, 字符串> {
    JSON生成追加字节(输出, 输出字节数, 34, 项位置)?;
    变量 位置 = 0;
    令 长度 = 文本字节长度(文本值);
    当 位置 < 长度 {
        令 值 = JSON生成读取字节(文本值, 位置, 项位置)?;
        如果 值 == 34 {
            JSON生成追加字节(输出, 输出字节数, 92, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 34, 项位置)?;
        } 否则 如果 值 == 92 {
            JSON生成追加字节(输出, 输出字节数, 92, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 92, 项位置)?;
        } 否则 如果 值 == 8 {
            JSON生成追加字节(输出, 输出字节数, 92, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 98, 项位置)?;
        } 否则 如果 值 == 9 {
            JSON生成追加字节(输出, 输出字节数, 92, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 116, 项位置)?;
        } 否则 如果 值 == 10 {
            JSON生成追加字节(输出, 输出字节数, 92, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 110, 项位置)?;
        } 否则 如果 值 == 12 {
            JSON生成追加字节(输出, 输出字节数, 92, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 102, 项位置)?;
        } 否则 如果 值 == 13 {
            JSON生成追加字节(输出, 输出字节数, 92, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 114, 项位置)?;
        } 否则 如果 值 < 32 {
            JSON生成追加字节(输出, 输出字节数, 92, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 117, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 48, 项位置)?;
            JSON生成追加字节(输出, 输出字节数, 48, 项位置)?;
            令 整数值 = 匹配 整数::从文本(值.到文本()) {
                结果::成功(结果值) => 结果值,
                结果::失败(_) => 0,
            };
            JSON生成追加字节(输出, 输出字节数, JSON十六进制字节(整数值 / 16), 项位置)?;
            JSON生成追加字节(输出, 输出字节数, JSON十六进制字节(整数值 % 16), 项位置)?;
        } 否则 {
            JSON生成追加字节(输出, 输出字节数, 值, 项位置)?;
        };
        位置 = 位置 + 1;
    }
    JSON生成追加字节(输出, 输出字节数, 34, 项位置)?;
    结果::成功(创建空值())
}

函数 JSON生成取出项(项目: 可变借用<列表<字符串>>, 项位置: 可变借用<整数>) -> 结果<字符串, 字符串> {
    令 当前位置 = *项位置;
    匹配 列表取出(项目) {
        可选::有值(项) => {
            令 新位置 = 当前位置 + 1;
            *项位置 = 新位置;
            结果::成功(项)
        },
        可选::空值 => 结果::失败(JSON生成错误(当前位置, "缺少 JSON 值或容器结束项")),
    }
}

函数 JSON生成值(项目: 可变借用<列表<字符串>>, 输出: 可变借用<列表<字节>>, 输出字节数: 可变借用<整数>, 项位置: 可变借用<整数>, 深度: 整数) -> 结果<空, 字符串> {
    令 当前位置 = *项位置;
    令 项 = JSON生成取出项(项目, 项位置)?;
    JSON生成当前值(项, 当前位置, 项目, 输出, 输出字节数, 项位置, 深度)
}

函数 JSON生成当前值(项: 字符串, 当前位置: 整数, 项目: 可变借用<列表<字符串>>, 输出: 可变借用<列表<字节>>, 输出字节数: 可变借用<整数>, 项位置: 可变借用<整数>, 深度: 整数) -> 结果<空, 字符串> {
    如果 非 JSON项有效(项) {
        返回 结果::失败(JSON生成错误(当前位置, "JSON 项类型标记无效"));
    }
    令 标记 = 匹配 文本字节(项, 0) {
        可选::有值(值) => 值,
        可选::空值 => 255,
    };
    如果 标记 == 48 {
        返回 JSON生成追加文本(输出, 输出字节数, "null", 当前位置);
    }
    如果 标记 == 98 {
        返回 JSON生成追加文本(输出, 输出字节数, JSON项文本(项)?, 当前位置);
    }
    如果 标记 == 110 {
        令 数字文本 = JSON项文本(项)?;
        JSON验证数字文本(数字文本)?;
        返回 JSON生成追加文本(输出, 输出字节数, 数字文本, 当前位置);
    }
    如果 标记 == 115 {
        令 字符串值 = JSON项文本(项)?;
        返回 JSON生成追加字符串(输出, 输出字节数, 字符串值, 当前位置);
    }
    如果 标记 == 91 {
        返回 JSON生成数组(项目, 输出, 输出字节数, 项位置, 深度, 当前位置);
    }
    如果 标记 == 123 {
        返回 JSON生成对象(项目, 输出, 输出字节数, 项位置, 深度, 当前位置);
    }
    结果::失败(JSON生成错误(当前位置, "此项不能作为 JSON 值"))
}

函数 JSON生成数组(项目: 可变借用<列表<字符串>>, 输出: 可变借用<列表<字节>>, 输出字节数: 可变借用<整数>, 项位置: 可变借用<整数>, 深度: 整数, 开始位置: 整数) -> 结果<空, 字符串> {
    如果 深度 >= 128 {
        返回 结果::失败(JSON生成错误(开始位置, "容器嵌套深度超过 128"));
    }
    JSON生成追加字节(输出, 输出字节数, 91, 开始位置)?;
    变量 首项 = 真;
    循环 {
        令 当前位置 = *项位置;
        令 项 = JSON生成取出项(项目, 项位置)?;
        如果 项 == "]" {
            JSON生成追加字节(输出, 输出字节数, 93, 当前位置)?;
            返回 结果::成功(创建空值());
        }
        如果 非 首项 {
            JSON生成追加字节(输出, 输出字节数, 44, 当前位置)?;
        }
        JSON生成当前值(项, 当前位置, 项目, 输出, 输出字节数, 项位置, 深度 + 1)?;
        首项 = 假;
    }
    结果::失败(JSON生成错误(*项位置, "数组缺少结束项"))
}

函数 JSON生成对象(项目: 可变借用<列表<字符串>>, 输出: 可变借用<列表<字节>>, 输出字节数: 可变借用<整数>, 项位置: 可变借用<整数>, 深度: 整数, 开始位置: 整数) -> 结果<空, 字符串> {
    如果 深度 >= 128 {
        返回 结果::失败(JSON生成错误(开始位置, "容器嵌套深度超过 128"));
    }
    JSON生成追加字节(输出, 输出字节数, 123, 开始位置)?;
    变量 首项 = 真;
    循环 {
        令 当前位置 = *项位置;
        令 项 = JSON生成取出项(项目, 项位置)?;
        如果 项 == "}" {
            JSON生成追加字节(输出, 输出字节数, 125, 当前位置)?;
            返回 结果::成功(创建空值());
        }
        如果 非 JSON项有效(项) {
            返回 结果::失败(JSON生成错误(当前位置, "对象需要成员项或结束项"));
        }
        令 类型 = JSON项类型(项)?;
        如果 类型 != "对象成员" {
            返回 结果::失败(JSON生成错误(当前位置, "对象需要成员项或结束项"));
        }
        如果 非 首项 {
            JSON生成追加字节(输出, 输出字节数, 44, 当前位置)?;
        }
        JSON生成追加字符串(输出, 输出字节数, JSON项文本(项)?, 当前位置)?;
        JSON生成追加字节(输出, 输出字节数, 58, 当前位置)?;
        JSON生成值(项目, 输出, 输出字节数, 项位置, 深度 + 1)?;
        首项 = 假;
    }
    结果::失败(JSON生成错误(*项位置, "对象缺少结束项"))
}

公开 函数 生成JSON文本(项目: 列表<字符串>) -> 结果<字符串, 字符串> {
    变量 剩余项目 = 项目;
    令 项数量 = 列表长度(剩余项目);
    如果 项数量 == 0 {
        返回 结果::失败(JSON生成错误(0, "缺少 JSON 值"));
    }
    如果 项数量 > 4096 {
        返回 结果::失败(JSON生成错误(4096, "输入项目数量超过 4096"));
    }
    变量 输出: 列表<字节> = 列表创建();
    变量 输出字节数 = 0;
    变量 项位置 = 0;
    JSON生成值(剩余项目, 输出, 输出字节数, 项位置, 0)?;
    如果 列表长度(剩余项目) != 0 {
        返回 结果::失败(JSON生成错误(项位置, "JSON 值后存在多余项目"));
    }
    匹配 从UTF8字节(输出) {
        结果::成功(文本值) => 结果::成功(文本值),
        结果::失败(_) => 结果::失败(JSON生成错误(项位置, "生成结果不是有效 UTF-8")),
    }
}
