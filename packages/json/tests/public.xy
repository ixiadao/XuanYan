函数 JSON项符合(项目: 可变借用<列表<字符串>>, 预期: 字符串) -> 布尔 {
    匹配 列表取出(项目) {
        可选::有值(项) => 项 == 预期,
        可选::空值 => 假,
    }
}

函数 JSON项类型符合(项: 借用<字符串>, 预期: 字符串) -> 布尔 {
    匹配 JSON项类型(项) {
        结果::成功(值) => 值 == 预期,
        结果::失败(_) => 假,
    }
}

函数 JSON项文本符合(项: 借用<字符串>, 预期: 字符串) -> 布尔 {
    匹配 JSON项文本(项) {
        结果::成功(值) => 值 == 预期,
        结果::失败(_) => 假,
    }
}

函数 JSON解析失败(文本值: 借用<字符串>) -> 布尔 {
    匹配 解析JSON文本(文本值) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    }
}

函数 JSON生成失败(项目: 列表<字符串>) -> 布尔 {
    匹配 生成JSON文本(项目) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    }
}

函数 JSON数字项目(文本值: 字符串) -> 字符串 {
    匹配 JSON创建数字项(文本值) {
        结果::成功(项) => 项,
        结果::失败(_) => "",
    }
}

函数 JSON需要位置(查找结果: 结果<可选<整数>, 字符串>) -> 结果<整数, 字符串> {
    匹配 查找结果 {
        结果::成功(位置) => 匹配 位置 {
            可选::有值(值) => 结果::成功(值),
            可选::空值 => 结果::失败("缺少预期 JSON 位置"),
        },
        结果::失败(错误) => 结果::失败(错误),
    }
}

函数 JSON导航样例() -> 结果<布尔, 字符串> {
    令 项目 = 解析JSON文本("{\"用户\":{\"名称\":\"玄言\",\"启用\":true},\"项目\":[10,{\"编号\":20}]}")?;
    令 用户位置 = JSON需要位置(JSON查找对象成员(项目, 0, "用户"))?;
    令 名称位置 = JSON需要位置(JSON查找对象成员(项目, 用户位置, "名称"))?;
    令 启用位置 = JSON需要位置(JSON查找对象成员(项目, 用户位置, "启用"))?;
    令 项目位置 = JSON需要位置(JSON查找对象成员(项目, 0, "项目"))?;
    令 第二项位置 = JSON需要位置(JSON查找数组元素(项目, 项目位置, 1))?;
    令 编号位置 = JSON需要位置(JSON查找对象成员(项目, 第二项位置, "编号"))?;
    令 缺少成员 = JSON查找对象成员(项目, 0, "不存在")?;
    结果::成功(JSON读取字符串值(项目, 名称位置)? == "玄言" 且 JSON读取布尔值(项目, 启用位置)? 且 JSON读取数字文本(项目, 编号位置)? == "20" 且 匹配 缺少成员 {
        可选::有值(_) => 假,
        可选::空值 => 真,
    })
}

函数 JSON嵌套数组项(数量: 整数) -> 列表<字符串> {
    变量 项目: 列表<字符串> = 列表创建();
    变量 下标 = 0;
    当 下标 < 数量 {
        列表追加(项目, JSON创建数组开始项());
        下标 = 下标 + 1;
    }
    列表追加(项目, JSON创建空值项());
    下标 = 0;
    当 下标 < 数量 {
        列表追加(项目, JSON创建数组结束项());
        下标 = 下标 + 1;
    }
    项目
}

函数 JSON空值数组项(数量: 整数) -> 列表<字符串> {
    变量 项目: 列表<字符串> = 列表创建();
    列表追加(项目, JSON创建数组开始项());
    变量 下标 = 0;
    当 下标 < 数量 {
        列表追加(项目, JSON创建空值项());
        下标 = 下标 + 1;
    }
    列表追加(项目, JSON创建数组结束项());
    项目
}

函数 JSON重复文本(数量: 整数) -> 字符串 {
    变量 文本值 = "";
    变量 下标 = 0;
    当 下标 < 数量 {
        文本追加(文本值, "a");
        下标 = 下标 + 1;
    }
    文本值
}

函数 JSON嵌套数组(数量: 整数) -> 字符串 {
    变量 文本值 = "";
    变量 下标 = 0;
    当 下标 < 数量 {
        文本追加(文本值, "[");
        下标 = 下标 + 1;
    }
    文本追加(文本值, "0");
    下标 = 0;
    当 下标 < 数量 {
        文本追加(文本值, "]");
        下标 = 下标 + 1;
    }
    文本值
}

函数 JSON空值数组(数量: 整数) -> 字符串 {
    变量 文本值 = "[";
    变量 下标 = 0;
    当 下标 < 数量 {
        如果 下标 > 0 {
            文本追加(文本值, ",");
        }
        文本追加(文本值, "null");
        下标 = 下标 + 1;
    }
    文本追加(文本值, "]");
    文本值
}

公开 函数 JSON完整值正确() -> 布尔 {
    令 文本值 = "{\"空\":null,\"真\":true,\"假\":false,\"数\":-12.30e+2,\"文\":\"玄\\u8A00\\uD83D\\uDE00\\n\",\"组\":[1,{}]}";
    匹配 解析JSON文本(文本值) {
        结果::失败(_) => 假,
        结果::成功(结果项) => {
            变量 项目 = 结果项;
            如果 列表长度(项目) != 18 {
                返回 假;
            }
            JSON项符合(项目, "{") 且 JSON项符合(项目, "k空") 且 JSON项符合(项目, "0") 且 JSON项符合(项目, "k真") 且 JSON项符合(项目, "btrue") 且 JSON项符合(项目, "k假") 且 JSON项符合(项目, "bfalse") 且 JSON项符合(项目, "k数") 且 JSON项符合(项目, "n-12.30e+2") 且 JSON项符合(项目, "k文") 且 JSON项符合(项目, "s玄言😀\n") 且 JSON项符合(项目, "k组") 且 JSON项符合(项目, "[") 且 JSON项符合(项目, "n1") 且 JSON项符合(项目, "{") 且 JSON项符合(项目, "}") 且 JSON项符合(项目, "]") 且 JSON项符合(项目, "}") 且 列表长度(项目) == 0
        },
    }
}

公开 函数 JSON项读取正确() -> 布尔 {
    JSON项类型符合("0", "空值") 且 JSON项类型符合("btrue", "布尔值") 且 JSON项类型符合("n1", "数字值") 且 JSON项类型符合("s", "字符串值") 且 JSON项类型符合("[", "数组开始") 且 JSON项类型符合("]", "数组结束") 且 JSON项类型符合("{", "对象开始") 且 JSON项类型符合("k名", "对象成员") 且 JSON项类型符合("}", "对象结束") 且 JSON项文本符合("0", "") 且 JSON项文本符合("bfalse", "false") 且 JSON项文本符合("n-1.5e2", "-1.5e2") 且 JSON项文本符合("s玄言😀", "玄言😀") 且 JSON项文本符合("k名称", "名称") 且 JSON项类型符合("", "") == 假 且 JSON项文本符合("bmaybe", "") == 假
}

公开 函数 JSON项构造正确() -> 布尔 {
    令 数字正确 = 匹配 JSON创建数字项("-12.30e+2") {
        结果::成功(项) => 项 == "n-12.30e+2",
        结果::失败(_) => 假,
    };
    令 数字错误 = 匹配 JSON创建数字项("01") {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    JSON创建空值项() == "0" 且 JSON创建布尔项(真) == "btrue" 且 JSON创建布尔项(假) == "bfalse" 且 JSON创建字符串项("玄言") == "s玄言" 且 JSON创建数组开始项() == "[" 且 JSON创建数组结束项() == "]" 且 JSON创建对象开始项() == "{" 且 JSON创建对象成员项("名称") == "k名称" 且 JSON创建对象结束项() == "}" 且 数字正确 且 数字错误
}

公开 函数 JSON事件导航正确() -> 布尔 {
    匹配 JSON导航样例() {
        结果::成功(值) => 值,
        结果::失败(_) => 假,
    }
}

公开 函数 JSON事件导航拒绝无效项目() -> 布尔 {
    变量 未结束对象: 列表<字符串> = 列表创建();
    列表追加(未结束对象, "{");
    列表追加(未结束对象, "k名称");
    列表追加(未结束对象, "s玄言");
    令 缺少结束失败 = 匹配 JSON查找对象成员(未结束对象, 0, "其他") {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    变量 数组: 列表<字符串> = 列表创建();
    列表追加(数组, "[");
    列表追加(数组, "n1");
    列表追加(数组, "]");
    令 负下标失败 = 匹配 JSON查找数组元素(数组, 0, -1) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    令 类型错误失败 = 匹配 JSON读取字符串值(数组, 1) {
        结果::成功(_) => 假,
        结果::失败(_) => 真,
    };
    缺少结束失败 且 负下标失败 且 类型错误失败
}

公开 函数 JSON文本生成正确() -> 布尔 {
    变量 项目: 列表<字符串> = 列表创建();
    列表追加(项目, JSON创建对象开始项());
    列表追加(项目, JSON创建对象成员项("空"));
    列表追加(项目, JSON创建空值项());
    列表追加(项目, JSON创建对象成员项("真"));
    列表追加(项目, JSON创建布尔项(真));
    列表追加(项目, JSON创建对象成员项("数"));
    列表追加(项目, JSON数字项目("-12.30e+2"));
    列表追加(项目, JSON创建对象成员项("文"));
    列表追加(项目, JSON创建字符串项("玄言😀\n\t\"\\\u{1}"));
    列表追加(项目, JSON创建对象成员项("组"));
    列表追加(项目, JSON创建数组开始项());
    列表追加(项目, JSON创建布尔项(假));
    列表追加(项目, JSON创建对象开始项());
    列表追加(项目, JSON创建对象结束项());
    列表追加(项目, JSON创建数组结束项());
    列表追加(项目, JSON创建对象结束项());
    令 生成正确 = 匹配 生成JSON文本(项目) {
        结果::成功(文本值) => 文本值 == "{\"空\":null,\"真\":true,\"数\":-12.30e+2,\"文\":\"玄言😀\\n\\t\\\"\\\\\\u0001\",\"组\":[false,{}]}",
        结果::失败(_) => 假,
    };
    令 往返正确 = 匹配 解析JSON文本(" { \"名称\" : \"玄\\u8A00\", \"数量\" : 2 } ") {
        结果::失败(_) => 假,
        结果::成功(解析项) => 匹配 生成JSON文本(解析项) {
            结果::成功(文本值) => 文本值 == "{\"名称\":\"玄言\",\"数量\":2}",
            结果::失败(_) => 假,
        },
    };
    生成正确 且 往返正确
}

公开 函数 JSON生成拒绝无效项目() -> 布尔 {
    变量 空项目: 列表<字符串> = 列表创建();
    令 空失败 = JSON生成失败(空项目);
    变量 错误标记: 列表<字符串> = 列表创建();
    列表追加(错误标记, "bmaybe");
    令 标记失败 = JSON生成失败(错误标记);
    变量 错误数字: 列表<字符串> = 列表创建();
    列表追加(错误数字, "n01");
    令 数字失败 = JSON生成失败(错误数字);
    变量 多余值: 列表<字符串> = 列表创建();
    列表追加(多余值, JSON创建空值项());
    列表追加(多余值, JSON创建空值项());
    令 多余失败 = JSON生成失败(多余值);
    变量 数组未结束: 列表<字符串> = 列表创建();
    列表追加(数组未结束, JSON创建数组开始项());
    列表追加(数组未结束, JSON创建空值项());
    令 数组失败 = JSON生成失败(数组未结束);
    变量 对象成员错误: 列表<字符串> = 列表创建();
    列表追加(对象成员错误, JSON创建对象开始项());
    列表追加(对象成员错误, JSON创建字符串项("名称"));
    列表追加(对象成员错误, JSON创建空值项());
    列表追加(对象成员错误, JSON创建对象结束项());
    空失败 且 标记失败 且 数字失败 且 多余失败 且 数组失败 且 JSON生成失败(对象成员错误)
}

公开 函数 JSON拒绝无效输入() -> 布尔 {
    JSON解析失败("") 且 JSON解析失败("tru") 且 JSON解析失败("[1,]") 且 JSON解析失败("{\"a\":1,}") 且 JSON解析失败("{\"a\" 1}") 且 JSON解析失败("01") 且 JSON解析失败("1.") 且 JSON解析失败("1e+") 且 JSON解析失败("\"a\nb\"") 且 JSON解析失败("\"\\q\"") 且 JSON解析失败("\"\\uDC00\"") 且 JSON解析失败("\"\\uD800x\"") 且 JSON解析失败("\"\\uD800\\u0000\"") 且 JSON解析失败("true false")
}

公开 函数 JSON边界正确() -> 布尔 {
    令 最大深度文本 = JSON嵌套数组(128);
    令 最大深度正确 = 匹配 解析JSON文本(最大深度文本) {
        结果::成功(项目) => 列表长度(项目) == 257,
        结果::失败(_) => 假,
    };
    如果 非 最大深度正确 或 非 JSON解析失败(JSON嵌套数组(129)) {
        返回 假;
    }
    令 最大项数文本 = JSON空值数组(4094);
    令 最大项数正确 = 匹配 解析JSON文本(最大项数文本) {
        结果::成功(项目) => 列表长度(项目) == 4096,
        结果::失败(_) => 假,
    };
    最大项数正确 且 JSON解析失败(JSON空值数组(4095))
}

公开 函数 JSON生成深度边界正确() -> 布尔 {
    令 最大深度正确 = 匹配 生成JSON文本(JSON嵌套数组项(128)) {
        结果::成功(文本值) => 文本长度(文本值) == 260,
        结果::失败(_) => 假,
    };
    最大深度正确 且 JSON生成失败(JSON嵌套数组项(129))
}

公开 函数 JSON生成项数边界正确() -> 布尔 {
    令 最大项数正确 = 匹配 生成JSON文本(JSON空值数组项(4094)) {
        结果::成功(_) => 真,
        结果::失败(_) => 假,
    };
    最大项数正确 且 JSON生成失败(JSON空值数组项(4095))
}

公开 函数 JSON生成输出边界正确() -> 布尔 {
    变量 最大输出项: 列表<字符串> = 列表创建();
    列表追加(最大输出项, JSON创建字符串项(JSON重复文本(1048574)));
    令 最大输出正确 = 匹配 生成JSON文本(最大输出项) {
        结果::成功(文本值) => 文本字节长度(文本值) == 1048576,
        结果::失败(_) => 假,
    };
    变量 超限输出项: 列表<字符串> = 列表创建();
    列表追加(超限输出项, JSON创建字符串项(JSON重复文本(1048575)));
    最大输出正确 且 JSON生成失败(超限输出项)
}
