公开 结构体 HTTP请求 {
    公开 方法: 字符串,
    公开 路径: 字符串,
    公开 正文: 列表<字节>,
    公开 保持连接: 布尔,
}

结构体 HTTP请求元数据 {
    方法: 字符串,
    路径: 字符串,
    正文长度: 整数,
    分块正文: 布尔,
    保持连接: 布尔,
}

结构体 HTTP请求头读取状态 {
    字节数: 整数,
    UTF8状态: 整数,
    结束匹配: 整数,
}

结构体 HTTP分块长度结果 {
    长度: 整数,
    元数据字节数: 整数,
}

函数 HTTP字节到文本(内容: 借用<列表<字节>>) -> 结果<字符串, 整数> {
    匹配 从UTF8字节(内容) {
        结果::成功(文本值) => 结果::成功(文本值),
        结果::失败(_) => 结果::失败(400),
    }
}

函数 HTTP下一UTF8状态(状态: 整数, 值: 字节) -> 整数 {
    如果 状态 < 0 {
        返回 -1;
    }
    如果 状态 == 0 {
        如果 值 < 128 {
            返回 0;
        }
        如果 值 >= 194 且 值 <= 223 {
            返回 1;
        }
        如果 值 == 224 {
            返回 4;
        }
        如果 值 >= 225 且 值 <= 236 或 值 >= 238 且 值 <= 239 {
            返回 2;
        }
        如果 值 == 237 {
            返回 5;
        }
        如果 值 == 240 {
            返回 6;
        }
        如果 值 >= 241 且 值 <= 243 {
            返回 3;
        }
        如果 值 == 244 {
            返回 7;
        }
        返回 -1;
    }
    如果 状态 == 4 {
        如果 值 >= 160 且 值 <= 191 {
            返回 1;
        }
        返回 -1;
    }
    如果 状态 == 5 {
        如果 值 >= 128 且 值 <= 159 {
            返回 1;
        }
        返回 -1;
    }
    如果 状态 == 6 {
        如果 值 >= 144 且 值 <= 191 {
            返回 2;
        }
        返回 -1;
    }
    如果 状态 == 7 {
        如果 值 >= 128 且 值 <= 143 {
            返回 2;
        }
        返回 -1;
    }
    如果 值 < 128 或 值 > 191 {
        返回 -1;
    }
    如果 状态 == 1 {
        返回 0;
    }
    状态 - 1
}

函数 HTTP十进制数位(值: 字节) -> 整数 {
    匹配 值 {
        48 => 0,
        49 => 1,
        50 => 2,
        51 => 3,
        52 => 4,
        53 => 5,
        54 => 6,
        55 => 7,
        56 => 8,
        57 => 9,
        _ => -1,
    }
}

函数 HTTP十六进制数位(值: 字节) -> 整数 {
    匹配 值 {
        48 => 0,
        49 => 1,
        50 => 2,
        51 => 3,
        52 => 4,
        53 => 5,
        54 => 6,
        55 => 7,
        56 => 8,
        57 => 9,
        65 => 10,
        66 => 11,
        67 => 12,
        68 => 13,
        69 => 14,
        70 => 15,
        97 => 10,
        98 => 11,
        99 => 12,
        100 => 13,
        101 => 14,
        102 => 15,
        _ => -1,
    }
}

函数 HTTP字节是空白(值: 字节) -> 布尔 {
    值 == 32 或 值 == 9
}

函数 HTTP字节是禁止控制字符(值: 字节) -> 布尔 {
    值 < 32 且 值 != 9 或 值 == 127
}

函数 HTTP字节是字段名称字符(值: 字节) -> 布尔 {
    值 >= 48 且 值 <= 57 或 值 >= 65 且 值 <= 90 或 值 >= 97 且 值 <= 122 或 值 == 33 或 值 == 35 或 值 == 36 或 值 == 37 或 值 == 38 或 值 == 39 或 值 == 42 或 值 == 43 或 值 == 45 或 值 == 46 或 值 == 94 或 值 == 95 或 值 == 96 或 值 == 124 或 值 == 126
}

函数 HTTP字节是URI主机字符(值: 字节) -> 布尔 {
    值 >= 48 且 值 <= 57 或 值 >= 65 且 值 <= 90 或 值 >= 97 且 值 <= 122 或 值 == 33 或 值 == 36 或 值 == 38 或 值 == 39 或 值 == 40 或 值 == 41 或 值 == 42 或 值 == 43 或 值 == 44 或 值 == 45 或 值 == 46 或 值 == 59 或 值 == 61 或 值 == 95 或 值 == 126
}

函数 HTTP内容类型含禁止控制字符(内容类型: 借用<字符串>) -> 布尔 {
    变量 下标 = 0;
    当 下标 < 文本字节长度(内容类型) {
        匹配 文本字节(内容类型, 下标) {
            可选::有值(字节值) => {
                如果 HTTP字节是禁止控制字符(字节值) {
                    返回 真;
                }
            },
            可选::空值 => {
                返回 真;
            },
        };
        下标 = 下标 + 1;
    }
    假
}

函数 HTTP字节等于小写(值: 字节, 小写值: 字节) -> 布尔 {
    值 == 小写值 或 值 >= 65 且 值 <= 90 且 值 + 32 == 小写值
}

函数 HTTP字节继续匹配(候选: 布尔, 下标: 整数, 字节值: 字节, 文本值: 借用<字符串>) -> 布尔 {
    如果 非 候选 {
        返回 假;
    }
    匹配 文本字节(文本值, 下标) {
        可选::有值(预期字节) => 字节值 == 预期字节,
        可选::空值 => 假,
    }
}

函数 HTTP字段继续匹配(候选: 布尔, 下标: 整数, 字节值: 字节, 小写名称: 借用<字符串>) -> 布尔 {
    如果 非 候选 {
        返回 假;
    }
    匹配 文本字节(小写名称, 下标) {
        可选::有值(名称字节) => HTTP字节等于小写(字节值, 名称字节),
        可选::空值 => 假,
    }
}

函数 读取HTTP请求头字节(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 最大请求头字节数: 整数, 状态: 可变借用<HTTP请求头读取状态>) -> 结果<可选<字节>, 整数> {
    匹配 读取下一个字节(连接, 缓冲区, 空闲超时毫秒)? {
        可选::空值 => 结果::成功(可选::空值),
        可选::有值(当前字节) => {
            状态.字节数 = 状态.字节数 + 1;
            如果 状态.字节数 > 最大请求头字节数 {
                返回 结果::失败(431);
            }
            状态.UTF8状态 = HTTP下一UTF8状态(状态.UTF8状态, 当前字节);
            如果 状态.结束匹配 == 0 {
                状态.结束匹配 = 如果 当前字节 == 13 {
                    1
                } 否则 {
                    0
                };
            } 否则 如果 状态.结束匹配 == 1 {
                状态.结束匹配 = 如果 当前字节 == 10 {
                    2
                } 否则 {
                    如果 当前字节 == 13 {
                        1
                    } 否则 {
                        0
                    }
                };
            } 否则 如果 状态.结束匹配 == 2 {
                状态.结束匹配 = 如果 当前字节 == 13 {
                    3
                } 否则 {
                    0
                };
            } 否则 如果 状态.结束匹配 == 3 {
                状态.结束匹配 = 如果 当前字节 == 10 {
                    4
                } 否则 {
                    如果 当前字节 == 13 {
                        1
                    } 否则 {
                        0
                    }
                };
            } 否则 {};
            结果::成功(可选::有值(当前字节))
        },
    }
}

函数 读取必需HTTP请求头字节(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 最大请求头字节数: 整数, 状态: 可变借用<HTTP请求头读取状态>) -> 结果<字节, 整数> {
    匹配 读取HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 状态)? {
        可选::有值(字节值) => 结果::成功(字节值),
        可选::空值 => 结果::失败(400),
    }
}

函数 完成HTTP请求头错误(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 最大请求头字节数: 整数, 状态: 可变借用<HTTP请求头读取状态>, 状态码: 整数) -> 结果<HTTP请求元数据, 整数> {
    当 状态.结束匹配 != 4 {
        匹配 读取HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 状态)? {
            可选::有值(_) => {},
            可选::空值 => {
                返回 结果::失败(400);
            },
        };
    }
    如果 状态.UTF8状态 != 0 {
        返回 结果::失败(400);
    }
    结果::失败(状态码)
}

函数 读取HTTP请求头(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 最大请求头字节数: 整数) -> 结果<HTTP请求元数据, 整数> {
    变量 读取状态 = HTTP请求头读取状态 { 字节数: 0, UTF8状态: 0, 结束匹配: 0 };
    变量 方法长度 = 0;
    变量 是GET = 真;
    变量 是HEAD = 真;
    变量 是POST = 真;
    变量 当前字节: 字节 = 0;
    匹配 读取HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)? {
        可选::有值(首字节) => {
            当前字节 = 首字节;
        },
        可选::空值 => {
            返回 结果::失败(0);
        },
    };
    当 当前字节 != 32 {
        如果 当前字节 == 13 或 当前字节 == 10 {
            返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
        }
        如果 HTTP字节是禁止控制字符(当前字节) {
            返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
        }
        如果 非 HTTP字节是字段名称字符(当前字节) {
            返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
        }
        是GET = HTTP字节继续匹配(是GET, 方法长度, 当前字节, "GET");
        是HEAD = HTTP字节继续匹配(是HEAD, 方法长度, 当前字节, "HEAD");
        是POST = HTTP字节继续匹配(是POST, 方法长度, 当前字节, "POST");
        方法长度 = 方法长度 + 1;
        当前字节 = 读取必需HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)?;
    }
    如果 方法长度 == 0 {
        返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
    }
    变量 路径字节: 列表<字节> = 列表创建();
    变量 路径字节数 = 0;
    变量 路径有效 = 真;
    变量 已有查询 = 假;
    当前字节 = 读取必需HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)?;
    当 当前字节 != 32 {
        如果 当前字节 == 13 或 当前字节 == 10 {
            返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
        }
        如果 当前字节 == 9 或 HTTP字节是禁止控制字符(当前字节) {
            返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
        }
        如果 路径字节数 == 0 且 当前字节 != 47 或 路径字节数 == 1 且 当前字节 == 47 {
            路径有效 = 假;
        }
        如果 当前字节 == 92 或 当前字节 == 35 或 当前字节 == 0 {
            路径有效 = 假;
        }
        如果 当前字节 == 63 且 非 已有查询 {
            已有查询 = 真;
        } 否则 {
            如果 非 已有查询 {
                列表追加(路径字节, 当前字节);
            }
        };
        路径字节数 = 路径字节数 + 1;
        当前字节 = 读取必需HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)?;
    }
    如果 路径字节数 == 0 {
        路径有效 = 假;
    }
    变量 版本下标 = 0;
    当 版本下标 < 8 {
        如果 非 HTTP字节继续匹配(真, 版本下标, 读取必需HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)?, "HTTP/1.1") {
            返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
        }
        版本下标 = 版本下标 + 1;
    }
    如果 读取必需HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)? != 13 或 读取必需HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)? != 10 {
        返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
    }
    变量 方法 = "";
    如果 是GET 且 方法长度 == 3 {
        方法 = "GET";
    } 否则 如果 是HEAD 且 方法长度 == 4 {
        方法 = "HEAD";
    } 否则 如果 是POST 且 方法长度 == 4 {
        方法 = "POST";
    } 否则 {
        返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 405);
    };
    变量 主机数量 = 0;
    变量 正文长度 = 0;
    变量 已有正文长度 = 假;
    变量 分块正文 = 假;
    变量 已有传输编码 = 假;
    变量 保持连接 = 真;
    变量 请求头结束 = 假;
    当 非 请求头结束 {
        变量 行字节数 = 0;
        变量 已有冒号 = 假;
        变量 名称长度 = 0;
        变量 名称已开始 = 假;
        变量 名称已结束 = 假;
        变量 字段名有前导空白 = 假;
        变量 是主机 = 真;
        变量 是正文长度 = 真;
        变量 是传输编码 = 真;
        变量 是连接 = 真;
        变量 连接值有效 = 真;
        变量 值已开始 = 假;
        变量 值已结束 = 假;
        变量 值有效 = 真;
        变量 主机值已结束 = 假;
        变量 主机值有效 = 真;
        变量 主机内容长度 = 0;
        变量 主机百分号剩余 = 0;
        变量 主机是字面量 = 假;
        变量 主机字面量已结束 = 假;
        变量 主机是端口 = 假;
        变量 主机端口已开始 = 假;
        变量 传输编码值有效 = 真;
        变量 行正文长度 = 0;
        变量 传输编码长度 = 0;
        变量 是分块 = 真;
        变量 关闭令牌长度 = 0;
        变量 是关闭令牌 = 真;
        变量 关闭令牌已结束 = 假;
        变量 行包含关闭 = 假;
        变量 行结束 = 假;
        当前字节 = 读取必需HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)?;
        当 非 行结束 {
            如果 当前字节 == 13 {
                令 下一字节 = 读取必需HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)?;
                如果 下一字节 == 10 {
                    行结束 = 真;
                    继续;
                }
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            如果 当前字节 == 10 {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            如果 HTTP字节是禁止控制字符(当前字节) {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            行字节数 = 行字节数 + 1;
            如果 非 已有冒号 {
                如果 当前字节 == 58 {
                    已有冒号 = 真;
                    是主机 = 是主机 且 名称长度 == 4;
                    是正文长度 = 是正文长度 且 名称长度 == 14;
                    是传输编码 = 是传输编码 且 名称长度 == 17;
                    是连接 = 是连接 且 名称长度 == 10;
                } 否则 {
                    如果 非 HTTP字节是空白(当前字节) 且 非 HTTP字节是字段名称字符(当前字节) {
                        返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
                    }
                    如果 HTTP字节是空白(当前字节) {
                        如果 非 名称已开始 且 行字节数 == 1 {
                            字段名有前导空白 = 真;
                        }
                        如果 名称已开始 {
                            名称已结束 = 真;
                        }
                    } 否则 {
                        如果 名称已结束 {
                            是主机 = 假;
                            是正文长度 = 假;
                            是传输编码 = 假;
                            是连接 = 假;
                        } 否则 {
                            是主机 = HTTP字段继续匹配(是主机, 名称长度, 当前字节, "host");
                            是正文长度 = HTTP字段继续匹配(是正文长度, 名称长度, 当前字节, "content-length");
                            是传输编码 = HTTP字段继续匹配(是传输编码, 名称长度, 当前字节, "transfer-encoding");
                            是连接 = HTTP字段继续匹配(是连接, 名称长度, 当前字节, "connection");
                        };
                        名称已开始 = 真;
                        名称长度 = 名称长度 + 1;
                    }
                }
            } 否则 如果 是主机 {
                如果 HTTP字节是空白(当前字节) {
                    如果 值已开始 {
                        主机值已结束 = 真;
                    }
                } 否则 {
                    如果 主机值已结束 {
                        主机值有效 = 假;
                    }
                    如果 主机值有效 {
                        如果 主机百分号剩余 > 0 {
                            如果 HTTP十六进制数位(当前字节) < 0 {
                                主机值有效 = 假;
                            } 否则 {
                                主机百分号剩余 = 主机百分号剩余 - 1;
                            }
                        } 否则 如果 主机是端口 {
                            如果 HTTP十进制数位(当前字节) < 0 {
                                主机值有效 = 假;
                            } 否则 {
                                主机端口已开始 = 真;
                            }
                        } 否则 如果 主机字面量已结束 {
                            如果 当前字节 != 58 {
                                主机值有效 = 假;
                            } 否则 {
                                主机是端口 = 真;
                            }
                        } 否则 如果 主机是字面量 {
                            如果 当前字节 == 93 {
                                如果 主机内容长度 == 0 {
                                    主机值有效 = 假;
                                } 否则 {
                                    主机字面量已结束 = 真;
                                }
                            } 否则 如果 当前字节 == 37 {
                                主机百分号剩余 = 2;
                                主机内容长度 = 主机内容长度 + 1;
                            } 否则 如果 当前字节 == 58 或 HTTP字节是URI主机字符(当前字节) {
                                主机内容长度 = 主机内容长度 + 1;
                            } 否则 {
                                主机值有效 = 假;
                            }
                        } 否则 {
                            如果 当前字节 == 91 {
                                如果 主机内容长度 != 0 {
                                    主机值有效 = 假;
                                } 否则 {
                                    主机是字面量 = 真;
                                }
                            } 否则 如果 当前字节 == 58 {
                                如果 主机内容长度 == 0 {
                                    主机值有效 = 假;
                                } 否则 {
                                    主机是端口 = 真;
                                }
                            } 否则 如果 当前字节 == 37 {
                                主机百分号剩余 = 2;
                                主机内容长度 = 主机内容长度 + 1;
                            } 否则 如果 HTTP字节是URI主机字符(当前字节) {
                                主机内容长度 = 主机内容长度 + 1;
                            } 否则 {
                                主机值有效 = 假;
                            }
                        }
                    }
                    值已开始 = 真;
                }
            } 否则 如果 是正文长度 {
                如果 HTTP字节是空白(当前字节) {
                    如果 值已开始 {
                        值已结束 = 真;
                    }
                } 否则 {
                    值已开始 = 真;
                    如果 值已结束 {
                        值有效 = 假;
                    } 否则 {
                        令 数位 = HTTP十进制数位(当前字节);
                        如果 数位 < 0 或 行正文长度 > 922337203685477580 或 行正文长度 == 922337203685477580 且 数位 > 7 {
                            值有效 = 假;
                        } 否则 {
                            行正文长度 = 行正文长度 * 10 + 数位;
                        }
                    }
                }
            } 否则 如果 是传输编码 {
                如果 HTTP字节是空白(当前字节) {
                    如果 值已开始 {
                        值已结束 = 真;
                    }
                } 否则 {
                    如果 非 HTTP字节是字段名称字符(当前字节) 或 值已结束 {
                        传输编码值有效 = 假;
                    }
                    值已开始 = 真;
                    如果 值已结束 {
                        是分块 = 假;
                    } 否则 {
                        是分块 = HTTP字段继续匹配(是分块, 传输编码长度, 当前字节, "chunked");
                        传输编码长度 = 传输编码长度 + 1;
                    }
                }
            } 否则 如果 是连接 {
                如果 当前字节 == 44 {
                    如果 关闭令牌长度 == 0 {
                        连接值有效 = 假;
                    }
                    如果 是关闭令牌 且 关闭令牌长度 == 5 {
                        行包含关闭 = 真;
                    }
                    关闭令牌长度 = 0;
                    是关闭令牌 = 真;
                    关闭令牌已结束 = 假;
                } 否则 如果 HTTP字节是空白(当前字节) {
                    如果 关闭令牌长度 > 0 {
                        关闭令牌已结束 = 真;
                    }
                } 否则 {
                    如果 非 HTTP字节是字段名称字符(当前字节) 或 关闭令牌已结束 {
                        连接值有效 = 假;
                    }
                    如果 关闭令牌已结束 {
                        是关闭令牌 = 假;
                    } 否则 {
                        是关闭令牌 = HTTP字段继续匹配(是关闭令牌, 关闭令牌长度, 当前字节, "close");
                    };
                    关闭令牌长度 = 关闭令牌长度 + 1;
                }
            } 否则 {};
            当前字节 = 读取必需HTTP请求头字节(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态)?;
        }
        如果 行字节数 == 0 {
            请求头结束 = 真;
            继续;
        }
        如果 非 已有冒号 或 非 名称已开始 或 字段名有前导空白 {
            返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
        }
        如果 是主机 {
            主机数量 = 主机数量 + 1;
            如果 非 值已开始 或 非 主机值有效 或 主机数量 > 1 或 主机内容长度 == 0 或 主机百分号剩余 != 0 或 主机是字面量 且 非 主机字面量已结束 或 主机是端口 且 非 主机端口已开始 {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            继续;
        }
        如果 是正文长度 {
            如果 已有正文长度 或 已有传输编码 {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            如果 非 值已开始 或 非 值有效 {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            正文长度 = 行正文长度;
            已有正文长度 = 真;
            继续;
        }
        如果 是传输编码 {
            如果 已有传输编码 或 已有正文长度 {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            如果 非 值已开始 {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            如果 非 传输编码值有效 {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            如果 非 是分块 或 传输编码长度 != 7 {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 501);
            }
            分块正文 = 真;
            已有传输编码 = 真;
            继续;
        }
        如果 是连接 {
            如果 非 连接值有效 或 关闭令牌长度 == 0 {
                返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
            }
            如果 是关闭令牌 且 关闭令牌长度 == 5 {
                行包含关闭 = 真;
            }
            如果 行包含关闭 {
                保持连接 = 假;
            }
        }
    }
    如果 主机数量 != 1 {
        返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
    }
    如果 非 路径有效 {
        返回 完成HTTP请求头错误(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 读取状态, 400);
    }
    如果 读取状态.UTF8状态 != 0 {
        返回 结果::失败(400);
    }
    结果::成功(HTTP请求元数据 { 方法, 路径: HTTP字节到文本(路径字节)?, 正文长度, 分块正文, 保持连接 })
}

函数 读取下一个字节(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数) -> 结果<可选<字节>, 整数> {
    匹配 列表取出末项(缓冲区) {
        可选::有值(字节值) => {
            返回 结果::成功(可选::有值(字节值));
        },
        可选::空值 => {},
    };
    变量 可以读取 = 假;
    匹配 TCP连接等待读取(连接, 空闲超时毫秒) {
        结果::成功(就绪) => {
            可以读取 = 就绪;
        },
        结果::失败(_) => {
            返回 结果::失败(500);
        },
    };
    如果 非 可以读取 {
        返回 结果::失败(408);
    }
    匹配 TCP连接接收字节(连接, 4096) {
        结果::失败(_) => 结果::失败(400),
        结果::成功(接收结果) => {
            匹配 接收结果 {
                可选::空值 => 结果::成功(可选::空值),
                可选::有值(分块) => {
                    遍历 字节值 在 (分块) {
                        列表追加(缓冲区, 字节值);
                    }
                    列表反转(缓冲区);
                    结果::成功(列表取出末项(缓冲区))
                },
            }
        },
    }
}

函数 读取HTTP正文(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 正文长度: 整数) -> 结果<列表<字节>, 整数> {
    变量 正文: 列表<字节> = 列表创建();
    当 列表长度(正文) < 正文长度 {
        匹配 读取下一个字节(连接, 缓冲区, 空闲超时毫秒)? {
            可选::有值(字节值) => 列表追加(正文, 字节值),
            可选::空值 => {
                返回 结果::失败(400);
            },
        };
    }
    结果::成功(正文)
}

函数 读取HTTP分块长度(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 最大行字节数: 整数, 最大长度: 整数) -> 结果<HTTP分块长度结果, 整数> {
    变量 长度 = 0;
    变量 行字节数 = 0;
    变量 已有数位 = 假;
    变量 已有扩展 = 假;
    变量 扩展非空 = 假;
    变量 解析状态码 = 0;
    当 真 {
        匹配 读取下一个字节(连接, 缓冲区, 空闲超时毫秒)? {
            可选::空值 => {
                返回 结果::失败(400);
            },
            可选::有值(字节值) => {
                如果 字节值 == 13 {
                    匹配 读取下一个字节(连接, 缓冲区, 空闲超时毫秒)? {
                        可选::有值(下一字节) => {
                            如果 下一字节 != 10 {
                                返回 结果::失败(400);
                            }
                        },
                        可选::空值 => {
                            返回 结果::失败(400);
                        },
                    };
                    如果 解析状态码 != 0 {
                        返回 结果::失败(解析状态码);
                    }
                    如果 非 已有数位 或 已有扩展 且 非 扩展非空 {
                        返回 结果::失败(400);
                    }
                    返回 结果::成功(HTTP分块长度结果 { 长度, 元数据字节数: 行字节数 + 2 });
                }
                如果 字节值 == 10 {
                    返回 结果::失败(400);
                }
                行字节数 = 行字节数 + 1;
                如果 行字节数 > 最大行字节数 {
                    返回 结果::失败(431);
                }
                如果 解析状态码 != 0 {
                    继续;
                }
                如果 HTTP字节是禁止控制字符(字节值) {
                    解析状态码 = 400;
                    继续;
                }
                如果 已有扩展 {
                    如果 字节值 != 32 且 字节值 != 9 {
                        扩展非空 = 真;
                    }
                    继续;
                }
                如果 字节值 == 59 {
                    如果 非 已有数位 {
                        解析状态码 = 400;
                        继续;
                    }
                    已有扩展 = 真;
                    继续;
                }
                令 数位 = HTTP十六进制数位(字节值);
                如果 数位 < 0 {
                    解析状态码 = 400;
                    继续;
                }
                如果 数位 > 最大长度 或 长度 > (最大长度 - 数位) / 16 {
                    解析状态码 = 413;
                    继续;
                }
                长度 = 长度 * 16 + 数位;
                已有数位 = 真;
            },
        };
    }
    结果::失败(500)
}

函数 读取HTTP回车换行(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数) -> 结果<布尔, 整数> {
    匹配 读取下一个字节(连接, 缓冲区, 空闲超时毫秒)? {
        可选::有值(字节值) => {
            如果 字节值 != 13 {
                返回 结果::失败(400);
            }
        },
        可选::空值 => {
            返回 结果::失败(400);
        },
    };
    匹配 读取下一个字节(连接, 缓冲区, 空闲超时毫秒)? {
        可选::有值(字节值) => {
            如果 字节值 == 10 {
                结果::成功(真)
            } 否则 {
                结果::失败(400)
            }
        },
        可选::空值 => 结果::失败(400),
    }
}

函数 读取HTTP尾部行(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 最大行字节数: 整数) -> 结果<整数, 整数> {
    变量 行字节数 = 0;
    变量 已有冒号 = 假;
    变量 已有名称 = 假;
    变量 名称已结束 = 假;
    变量 名称长度 = 0;
    变量 字段名有前导空白 = 假;
    变量 是正文长度 = 真;
    变量 是传输编码 = 真;
    变量 是主机 = 真;
    变量 字段有效 = 真;
    当 真 {
        匹配 读取下一个字节(连接, 缓冲区, 空闲超时毫秒)? {
            可选::空值 => {
                返回 结果::失败(400);
            },
            可选::有值(字节值) => {
                如果 字节值 == 13 {
                    匹配 读取下一个字节(连接, 缓冲区, 空闲超时毫秒)? {
                        可选::有值(下一字节) => {
                            如果 下一字节 != 10 {
                                返回 结果::失败(400);
                            }
                        },
                        可选::空值 => {
                            返回 结果::失败(400);
                        },
                    };
                    如果 行字节数 == 0 {
                        返回 结果::成功(2);
                    }
                    如果 非 字段有效 或 非 已有冒号 或 非 已有名称 或 字段名有前导空白 {
                        返回 结果::失败(400);
                    }
                    如果 是正文长度 且 名称长度 == 14 或 是传输编码 且 名称长度 == 17 或 是主机 且 名称长度 == 4 {
                        返回 结果::失败(400);
                    }
                    返回 结果::成功(行字节数 + 2);
                }
                如果 字节值 == 10 {
                    返回 结果::失败(400);
                }
                行字节数 = 行字节数 + 1;
                如果 行字节数 > 最大行字节数 {
                    返回 结果::失败(431);
                }
                如果 非 字段有效 {
                    继续;
                }
                如果 HTTP字节是禁止控制字符(字节值) {
                    字段有效 = 假;
                    继续;
                }
                如果 已有冒号 {
                    继续;
                }
                如果 字节值 == 58 {
                    已有冒号 = 真;
                    继续;
                }
                如果 非 HTTP字节是空白(字节值) 且 非 HTTP字节是字段名称字符(字节值) {
                    字段有效 = 假;
                    继续;
                }
                如果 HTTP字节是空白(字节值) {
                    如果 非 已有名称 且 行字节数 == 1 {
                        字段名有前导空白 = 真;
                    }
                    如果 已有名称 {
                        名称已结束 = 真;
                    }
                    继续;
                }
                如果 名称已结束 {
                    是正文长度 = 假;
                    是传输编码 = 假;
                    是主机 = 假;
                } 否则 {
                    是正文长度 = HTTP字段继续匹配(是正文长度, 名称长度, 字节值, "content-length");
                    是传输编码 = HTTP字段继续匹配(是传输编码, 名称长度, 字节值, "transfer-encoding");
                    是主机 = HTTP字段继续匹配(是主机, 名称长度, 字节值, "host");
                };
                已有名称 = 真;
                名称长度 = 名称长度 + 1;
            },
        };
    }
    结果::失败(500)
}

函数 读取HTTP尾部(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 最大元数据字节数: 整数, 已用元数据字节数: 整数) -> 结果<布尔, 整数> {
    变量 已用字节数 = 已用元数据字节数;
    当 真 {
        如果 最大元数据字节数 - 已用字节数 < 2 {
            返回 结果::失败(431);
        }
        令 行字节数 = 读取HTTP尾部行(连接, 缓冲区, 空闲超时毫秒, 最大元数据字节数 - 已用字节数 - 2)?;
        已用字节数 = 已用字节数 + 行字节数;
        如果 行字节数 == 2 {
            返回 结果::成功(真);
        }
    }
    结果::失败(500)
}

函数 读取HTTP分块正文(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 最大元数据字节数: 整数, 最大正文字节数: 整数) -> 结果<列表<字节>, 整数> {
    变量 正文: 列表<字节> = 列表创建();
    变量 元数据字节数 = 0;
    当 真 {
        如果 最大元数据字节数 - 元数据字节数 < 2 {
            返回 结果::失败(431);
        }
        令 长度结果 = 读取HTTP分块长度(连接, 缓冲区, 空闲超时毫秒, 最大元数据字节数 - 元数据字节数 - 2, 最大正文字节数 - 列表长度(正文))?;
        元数据字节数 = 元数据字节数 + 长度结果.元数据字节数;
        令 分块长度 = 长度结果.长度;
        如果 分块长度 == 0 {
            读取HTTP尾部(连接, 缓冲区, 空闲超时毫秒, 最大元数据字节数, 元数据字节数)?;
            返回 结果::成功(正文);
        }
        变量 剩余字节数 = 分块长度;
        当 剩余字节数 > 0 {
            匹配 读取下一个字节(连接, 缓冲区, 空闲超时毫秒)? {
                可选::有值(字节值) => 列表追加(正文, 字节值),
                可选::空值 => {
                    返回 结果::失败(400);
                },
            };
            剩余字节数 = 剩余字节数 - 1;
        }
        读取HTTP回车换行(连接, 缓冲区, 空闲超时毫秒)?;
    }
    结果::失败(500)
}

公开 函数 读取HTTP请求(连接: 可变借用<TCP连接>, 缓冲区: 可变借用<列表<字节>>, 空闲超时毫秒: 整数, 最大请求头字节数: 整数, 最大正文字节数: 整数, 请求: 可变借用<HTTP请求>) -> 整数 {
    如果 空闲超时毫秒 < -1 或 空闲超时毫秒 > 2147483647 或 最大请求头字节数 <= 0 或 最大正文字节数 < 0 {
        返回 500;
    }
    匹配 读取HTTP请求头(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数) {
        结果::失败(状态码) => 状态码,
        结果::成功(元数据) => {
            匹配 元数据 {
                HTTP请求元数据 { 方法, 路径, 正文长度, 分块正文, 保持连接 } => {
                    令 正文结果 = 如果 分块正文 {
                        读取HTTP分块正文(连接, 缓冲区, 空闲超时毫秒, 最大请求头字节数, 最大正文字节数)
                    } 否则 {
                        如果 正文长度 > 最大正文字节数 {
                            返回 413;
                        }
                        读取HTTP正文(连接, 缓冲区, 空闲超时毫秒, 正文长度)
                    };
                    匹配 正文结果 {
                        结果::失败(状态码) => 状态码,
                        结果::成功(正文) => {
                            请求.方法 = 方法;
                            请求.路径 = 路径;
                            请求.正文 = 正文;
                            请求.保持连接 = 保持连接;
                            200
                        },
                    }
                },
            }
        },
    }
}

公开 函数 HTTP状态文本(状态码: 整数) -> 字符串 {
    如果 状态码 == 200 {
        返回 "OK";
    }
    如果 状态码 == 400 {
        返回 "Bad Request";
    }
    如果 状态码 == 404 {
        返回 "Not Found";
    }
    如果 状态码 == 405 {
        返回 "Method Not Allowed";
    }
    如果 状态码 == 408 {
        返回 "Request Timeout";
    }
    如果 状态码 == 413 {
        返回 "Payload Too Large";
    }
    如果 状态码 == 431 {
        返回 "Request Header Fields Too Large";
    }
    如果 状态码 == 501 {
        返回 "Not Implemented";
    }
    "Internal Server Error"
}

公开 函数 HTTP错误正文(状态码: 整数) -> 字符串 {
    变量 正文 = HTTP状态文本(状态码);
    文本追加(正文, "\n");
    正文
}

函数 规范状态码(状态码: 整数) -> 整数 {
    如果 状态码 == 200 或 状态码 == 400 或 状态码 == 404 或 状态码 == 405 或 状态码 == 408 或 状态码 == 413 或 状态码 == 431 或 状态码 == 500 或 状态码 == 501 {
        状态码
    } 否则 {
        500
    }
}

函数 创建空值() -> 空 {}

公开 函数 发送HTTP响应(连接: 可变借用<TCP连接>, 状态码: 整数, 内容类型: 借用<字符串>, 正文: 借用<列表<字节>>, 发送正文: 布尔, 保持连接: 布尔) -> 结果<空, 字符串> {
    如果 HTTP内容类型含禁止控制字符(内容类型) {
        返回 结果::失败("HTTP 内容类型不能包含控制字符");
    }
    令 有效状态码 = 规范状态码(状态码);
    变量 响应头 = "HTTP/1.1 ";
    文本追加(响应头, 有效状态码.到文本());
    文本追加(响应头, " ");
    文本追加(响应头, HTTP状态文本(有效状态码));
    文本追加(响应头, "\r\nConnection: ");
    文本追加(响应头, 如果 保持连接 {
        "keep-alive"
    } 否则 {
        "close"
    });
    文本追加(响应头, "\r\nContent-Length: ");
    文本追加(响应头, 列表长度(正文).到文本());
    文本追加(响应头, "\r\nContent-Type: ");
    文本追加(响应头, 内容类型);
    文本追加(响应头, "\r\n\r\n");
    令 响应头字节 = 文本到UTF8字节(响应头)?;
    TCP连接发送字节(连接, 响应头字节)?;
    如果 发送正文 {
        TCP连接发送字节(连接, 正文)?;
    }
    如果 非 保持连接 {
        TCP连接关闭发送(连接)?;
    }
    结果::成功(创建空值())
}

公开 函数 发送HTTP错误响应(连接: 可变借用<TCP连接>, 状态码: 整数, 发送正文: 布尔, 保持连接: 布尔) -> 结果<空, 字符串> {
    令 正文 = 文本到UTF8字节(HTTP错误正文(状态码))?;
    发送HTTP响应(连接, 状态码, "text/plain; charset=utf-8", 正文, 发送正文, 保持连接)
}

公开 函数 发送HTTPS客户端请求(方法: 借用<字符串>, 地址: 借用<字符串>, 请求头: 借用<字符串>, 正文: 借用<列表<字节>>, 超时毫秒: 整数) -> 结果<HTTPS响应, 字符串> {
    发送HTTPS请求(方法, 地址, 请求头, 正文, 超时毫秒)
}

公开 函数 获取HTTPS客户端响应(地址: 借用<字符串>, 超时毫秒: 整数) -> 结果<HTTPS响应, 字符串> {
    获取HTTPS响应(地址, 超时毫秒)
}

函数 HTTP响应头名称相同(实际名称: 借用<字符串>, 预期名称: 借用<字符串>) -> 布尔 {
    令 长度 = 文本字节长度(实际名称);
    如果 长度 != 文本字节长度(预期名称) {
        返回 假;
    }
    变量 下标 = 0;
    当 下标 < 长度 {
        匹配 文本字节(实际名称, 下标) {
            可选::有值(实际字节) => 匹配 文本字节(预期名称, 下标) {
                可选::有值(预期字节) => {
                    如果 非 HTTP字节等于小写(实际字节, 预期字节) 且 非 HTTP字节等于小写(预期字节, 实际字节) {
                        返回 假;
                    }
                },
                可选::空值 => {
                    返回 假;
                },
            },
            可选::空值 => {
                返回 假;
            },
        };
        下标 = 下标 + 1;
    }
    真
}

函数 HTTP去除可选空白(文本值: 字符串) -> 字符串 {
    变量 结果文本 = 文本值;
    当 文本长度(结果文本) > 0 且 (文本开头是(结果文本, " ") 或 文本开头是(结果文本, "\t")) {
        结果文本 = 匹配 文本截取(结果文本, 1, 文本长度(结果文本) - 1) {
            可选::有值(值) => 值,
            可选::空值 => "",
        };
    }
    当 文本长度(结果文本) > 0 且 (文本结尾是(结果文本, " ") 或 文本结尾是(结果文本, "\t")) {
        结果文本 = 匹配 文本截取(结果文本, 0, 文本长度(结果文本) - 1) {
            可选::有值(值) => 值,
            可选::空值 => "",
        };
    }
    结果文本
}

公开 函数 HTTP响应头首值(响应头: 借用<字符串>, 名称: 借用<字符串>) -> 可选<字符串> {
    如果 文本长度(名称) == 0 {
        返回 可选::空值;
    }
    变量 剩余开始 = 0;
    令 响应头长度 = 文本长度(响应头);
    当 剩余开始 < 响应头长度 {
        变量 剩余文本 = "";
        匹配 文本截取(响应头, 剩余开始, 响应头长度 - 剩余开始) {
            可选::有值(值) => {
                剩余文本 = 值;
            },
            可选::空值 => {
                返回 可选::空值;
            },
        };
        变量 有换行 = 假;
        变量 行长度 = 文本长度(剩余文本);
        匹配 文本查找(剩余文本, "\n") {
            可选::有值(位置) => {
                有换行 = 真;
                行长度 = 位置;
            },
            可选::空值 => {},
        };
        变量 行 = "";
        匹配 文本截取(剩余文本, 0, 行长度) {
            可选::有值(值) => {
                行 = 值;
            },
            可选::空值 => {
                返回 可选::空值;
            },
        };
        如果 文本结尾是(行, "\r") {
            行 = 匹配 文本截取(行, 0, 文本长度(行) - 1) {
                可选::有值(值) => 值,
                可选::空值 => "",
            };
        }
        匹配 文本查找(行, ":") {
            可选::有值(分隔位置) => {
                匹配 文本截取(行, 0, 分隔位置) {
                    可选::有值(实际名称) => {
                        如果 HTTP响应头名称相同(实际名称, 名称) {
                            令 值开始 = 分隔位置 + 1;
                            匹配 文本截取(行, 值开始, 文本长度(行) - 值开始) {
                                可选::有值(值) => {
                                    返回 可选::有值(HTTP去除可选空白(值));
                                },
                                可选::空值 => {},
                            };
                        }
                    },
                    可选::空值 => {},
                };
            },
            可选::空值 => {},
        };
        剩余开始 = 剩余开始 + 行长度 + 如果 有换行 {
            1
        } 否则 {
            0
        };
    }
    可选::空值
}
